import Kernel.Net.Tcp
import Kernel.Net.Fragment

open Kernel.Net.Tcp
open Kernel.Net.Internet (Peer Config)

private def bytes (xs : List UInt8) : ByteArray := ⟨xs.toArray⟩
private def remote : Peer := ⟨bytes [2,0,0,0,0,1], bytes [10,0,2,2]⟩
private def key : Key := ⟨remote.ip, 51000, 5005⟩
private def listener : Endpoint := { listenPort := 5005 }
private def client (seq answer : UInt32) (flags : UInt8 := ack) (data : ByteArray := .empty) : Segment :=
  { src := 51000, dst := 5005, seq, answer, flags, window := 3000, data }

private def rx (e : Endpoint) (s : Segment) (now := 0) : Endpoint × Array Event :=
  e.receive now 0xfffffffe remote s.encode

private def packets (events : Array Event) : Array Segment := events.filterMap fun
  | .emit _ raw => Segment.decode? raw
  | _ => none

private def data (events : Array Event) : ByteArray := events.foldl (fun out event =>
  match event with | .data _ bytes => out ++ bytes | _ => out) .empty

private def opened (events : Array Event) : Bool := events.any fun
  | .opened _ => true
  | _ => false

private def finished (events : Array Event) : Bool := events.any fun
  | .finished _ => true
  | _ => false

private def closed (events : Array Event) : Bool := events.any fun
  | .closed _ => true
  | _ => false

private def establish (mss : UInt16 := 1460) (window : UInt16 := 3000) : Endpoint :=
  let (half, _) := rx listener { client 0xfffffffd 0 syn with mss := some mss }
  (rx half { client 0xfffffffe 0xffffffff with window }).1

def main : IO UInt32 := do
  let failures ← IO.mkRef 0
  let check (label : String) (pass : Bool) : IO Unit := do
    unless pass do
      failures.modify (· + 1)
      IO.eprintln s!"FAIL {label}"

  -- A conventional three-way handshake from a peer using Linux-style SYN options:
  -- MSS, SACK-permitted, timestamps, NOP, and window scale.
  let raw := bytes [
    0xc7,0x38,0x13,0x8d,0xff,0xff,0xff,0xfd,0,0,0,0,
    0xa0,2,0x0b,0xb8,0,0,0,0,2,4,5,0xb4,4,2,8,10,0,0,0,1,0,0,0,0,1,3,3,7 ]
  let (half, synEvents) := listener.receive 0 0xfffffffe remote raw
  let synAck := (packets synEvents)[0]!
  check "SYN-ACK on the peer's ephemeral port"
    (half.conns.size == 1 && synAck.flags == syn ||| ack && synAck.seq == 0xfffffffe &&
     synAck.answer == 0xfffffffe && synAck.src == 5005 && synAck.dst == 51000 && synAck.mss == some 1460)
  check "repeated SYN preserves the initial sequence" ((packets (half.receive 70 9 remote raw).2)[0]!.seq == synAck.seq)
  check "SYN-ACK loss retried on timer"
    ((half.tick 999).2.isEmpty && (packets (half.tick 1000).2)[0]!.flags == syn ||| ack)
  let (est, accepted) := rx half (client 0xfffffffe 0xffffffff)
  check "peer's ACK opens connection" (opened accepted && est.conns[0]!.phase == .established)
  check "impossible ACK cannot release bytes" ((rx est (client 0xfffffffe 250)).1.conns[0]!.snd == 0xffffffff)
  check "invalid header offset is dropped" ((listener.receive 0 7 remote (raw.set! 12 0xf0)).2.isEmpty)
  check "malformed option length is dropped" ((listener.receive 0 7 remote (raw.set! 25 1)).2.isEmpty)
  check "truncated TCP header is dropped" ((listener.receive 0 7 remote (raw.extract 0 19)).2.isEmpty)
  let resetEvents := (rx listener { client 8 55 with dst := 5006 }).2
  check "closed port resets incoming ACK with its ACK number"
    ((packets resetEvents)[0]!.flags == rst && (packets resetEvents)[0]!.seq == 55)
  check "never reset a reset" ((rx listener { client 8 55 rst with dst := 5006 }).2.isEmpty)

  -- The first two stream bytes wrap RCV.NXT through zero. Later overlap consumes only fresh bytes.
  let (gap, gapEvents) := rx est (client 0 0xffffffff ack (bytes [3,4]))
  check "ahead of the gap receives a cumulative ACK" (data gapEvents == .empty && (packets gapEvents)[0]!.answer == 0xfffffffe)
  let (ordered, delivered) := rx gap (client 0xfffffffe 0xffffffff ack (bytes [1,2]))
  check "closing the gap delivers bytes in order across sequence wrap" (data delivered == bytes [1,2,3,4])
  let (_, duplicate) := rx ordered (client 0 0xffffffff ack (bytes [3,4]))
  check "duplicate stream bytes never reach the application twice" (data duplicate == .empty && (packets duplicate)[0]!.answer == 2)
  let (overlap, next) := rx ordered (client 1 0xffffffff ack (bytes [4,5]))
  check "overlapping retransmission delivers its suffix" (data next == bytes [5] && overlap.conns[0]!.rcv == 3)
  let (_, challenge) := rx overlap (client 4 0 rst)
  check "in-window reset challenges a non-exact sequence" (!closed challenge && (packets challenge)[0]!.flags == ack)
  let (gone, resetExact) := rx overlap (client 3 0 rst)
  check "exact reset releases the connection" (closed resetExact && gone.conns.isEmpty)

  -- A fixed IPv4 wire vector generated by an independent checksum implementation.
  -- The final fragment arrives first. TCP sees one 2052-byte write only after IP has both.
  let cfg : Config := { mac := bytes [2,0,0,0,0,15] }
  let link := cfg.mac ++ remote.mac ++ bytes [8,0]
  let firstIp := bytes [69,0,5,212,0,33,32,0,64,6,60,243,10,0,2,2,10,0,2,15]
  let lastIp := bytes [69,0,2,108,0,33,0,184,64,6,95,163,10,0,2,2,10,0,2,15]
  let head := bytes [199,56,19,141,255,255,255,254,255,255,255,255,80,24,11,184,3,150,0,0]
  let front : ByteArray := ⟨Array.replicate 1452 0xa5⟩
  let back : ByteArray := ⟨Array.replicate 600 0x5a⟩
  let cache : Kernel.Net.Fragment.Cache := {}
  let (cache, incomplete) := cache.receive 0 cfg (link ++ lastIp ++ back)
  let (_, complete) := cache.receive 1 cfg (link ++ firstIp ++ head ++ front)
  let stream := match complete with
    | some (.tcp p segment) => data (est.receive 2 17 p segment).2
    | _ => ByteArray.empty
  check "out-of-order IP fragments deliver one complete TCP write"
    (incomplete.isNone && stream == front ++ back)

  -- Reassembled IP can deliver a segment larger than an Ethernet frame. Even a segment
  -- straddling both ends of the window may supply only its in-window data and FIN.
  let big : ByteArray := ⟨Array.replicate (rxWindow.toNat + 150) 77⟩
  let start := 0xfffffffe - 100
  let (wide, part) := rx est (client start 0xffffffff (fin ||| ack) big)
  check "reassembled TCP is clipped at both receive-window edges"
    (data part == big.extract 100 (100 + rxWindow.toNat) && wide.conns[0]!.rcv == 0xfffffffe + rxWindow.toUInt32 &&
     !finished part)
  let (_, rest) := rx wide (client start 0xffffffff (fin ||| ack) big)
  check "remaining TCP bytes and FIN become acceptable as the window advances"
    ((data rest).size == 50 && finished rest)

  -- Peer MSS and advertised window each limit transmission. The first six bytes are emitted as 3+2+1.
  let small := establish 3 3
  let (withFlight, sent) := small.send 1 key (bytes [1,2,3,4,5,6])
  check "honors MSS and receive window" ((packets sent)[0]!.data == bytes [1,2,3])
  -- An out-of-order peer ACK previously advertised a three-byte window anchored
  -- at 0xffffffff. A reordered ACK can acknowledge those bytes without shifting that window.
  let (newer, _) := rx withFlight { client 0 0xffffffff with window := 3 } 2
  let (_, older) := rx newer { client 0xfffffffe 2 with window := 100 } 3
  check "reordered ACK never sends beyond the last accepted window right edge"
    ((packets older)[0]!.data.isEmpty)
  let (partialAck, paused) := rx withFlight { client 0xfffffffe 0 with window := 2 } 12
  check "partial ACK waits for remaining flight" ((packets paused).isEmpty)
  let (retried, due) := partialAck.tick 1012
  check "partial ACK retransmits from its ACK number" ((packets due)[0]!.seq == 0 && (packets due)[0]!.data == bytes [2,3])
  check "retransmission backs off" ((retried.tick 2012).2.isEmpty)
  let (withTail, tailSend) := rx retried { client 0xfffffffe 2 with window := 2 } 2013
  check "new window limits next piece" ((packets tailSend)[0]!.seq == 2 && (packets tailSend)[0]!.data == bytes [4,5])
  let (blocked, probe) := rx withTail { client 0xfffffffe 4 with window := 0 } 2014
  check "zero window retains pending bytes and probes" ((packets probe)[0]!.data.isEmpty && (packets probe)[0]!.seq == 3)
  check "lost window update is probed again" (!(packets (blocked.tick 3014).2).isEmpty)
  let (sentAll, tail) := rx blocked { client 0xfffffffe 4 with window := 1 } 3015
  check "reopened window releases the last queued byte" ((packets tail)[0]!.data == bytes [6])
  let (peerDone, eof) := rx sentAll (client 0xfffffffe 4 (fin ||| ack)) 3016
  check "peer half closes while a reply is outstanding" (finished eof && !closed eof)
  let (closing, noFin) := peerDone.close 3017 key
  check "FIN waits behind queued bytes" (noFin.isEmpty)
  let (lastAck, finSent) := rx closing (client 0xffffffff 5) 3018
  check "FIN follows last reply byte" ((packets finSent)[0]!.seq == 5 && (packets finSent)[0]!.has fin)
  let (released, ended) := rx lastAck (client 0xffffffff 6) 3019
  check "final ACK completes passive close" (closed ended && released.conns.isEmpty)

  let (active, outgoing) := listener.connect 0 20 remote 51001 443
  check "active open sends a SYN" ((packets outgoing)[0]!.seq == 20 && (packets outgoing)[0]!.dst == 443)
  let answer : Segment := { src := 443, dst := 51001, seq := 100, answer := 21, flags := syn ||| ack }
  let (active, connected) := rx active answer
  check "active open checks the SYN-ACK" (opened connected && (packets connected)[0]!.answer == 101)
  let (active, _) := active.close 1 ⟨remote.ip,443,51001⟩
  let peerFin := { answer with seq := 101, answer := 22, flags := fin ||| ack }
  let (waiting, ended) := rx active peerFin 2
  check "active close holds tuple in TIME-WAIT" (closed ended && waiting.conns[0]!.phase == .timeWait)
  let (waiting, finalAck) := rx waiting peerFin 100
  check "lost final ACK recovered in TIME-WAIT" ((packets finalAck)[0]!.answer == 102)
  check "TIME-WAIT expires" ((waiting.tick 120100).1.conns.isEmpty)

  let (bounded, overflow) := est.send 0 key ⟨Array.replicate (maxQueued + 1) 0⟩
  check "send overflow reclaims state and signals a reset" (bounded.conns.isEmpty && closed overflow && (packets overflow)[0]!.has rst)
  let full := (List.range (maxConnections + 2)).foldl
    (fun e i => (rx e { client 11 0 syn with src := (i+1).toUInt16 }).1) listener
  check "connection table remains bounded" (full.conns.size == maxConnections)
  check "idle timeout frees slots" ((full.tick 300000).1.conns.isEmpty)

  let failed ← failures.get
  if failed != 0 then return 1
  IO.println "net-tcp-test: all checks passed"
  return 0
