/-- Every whole block of `b` from `off`, `left` of them. -/
def blocks (b : @& ByteArray) : Nat → USize → State → State
  | 0, _, s => s
  | left + 1, off, s =>
    if h : off.toNat + 127 < b.size then blocks b left (off + 128) (compress s b off h) else s

/-- What is left of a message after its whole blocks, padded as the standard has it: a one bit, zeros,
and the length of the whole message in bits. One block, or two when the rest leaves no room. -/
def padded (b : @& ByteArray) (whole : Nat) : ByteArray :=
  let rest := b.extract whole b.size
  let lengthBytes := 16
  let total := if rest.size + 1 + lengthBytes ≤ 128 then 128 else 256
  let zeros := ByteArray.mk (Array.replicate (total - rest.size - 1 - 8) 0)   -- the top 8 bytes of the 16-byte length are zero
  let bitsLong := (b.size * 8).toUInt64
  (rest.push 0x80 ++ zeros) ++ ByteArray.mk ((List.range 8).map fun i => (bitsLong >>> (56 - 8 * i).toUInt64).toUInt8).toArray

/-- The state after all of `b`, from the starting state `start`. -/
def run (start : State) (b : @& ByteArray) : State :=
  let count := b.size / 128
  let s := blocks b count 0 start
  let last := padded b (count * 128)
  blocks last (last.size / 128) 0 s

def start512 : State := ⟨0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1, 0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179⟩
def start384 : State := ⟨0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939, 0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4⟩

@[inline] def word (out : ByteArray) (x : UInt64) : ByteArray :=
  (List.range 8).foldl (fun out i => out.push (x >>> (56 - 8 * i).toUInt64).toUInt8) out

/-- SHA-512 of `b`: 64 bytes. -/
def hash512 (b : @& ByteArray) : ByteArray :=
  let s := run start512 b
  [s.a, s.b, s.c, s.d, s.e, s.f, s.g, s.h].foldl word (ByteArray.emptyWithCapacity 64)

/-- SHA-384 of `b`: 48 bytes. -/
def hash384 (b : @& ByteArray) : ByteArray :=
  let s := run start384 b
  [s.a, s.b, s.c, s.d, s.e, s.f].foldl word (ByteArray.emptyWithCapacity 48)

end Tls.Sha512
