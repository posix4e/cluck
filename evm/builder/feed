#!/usr/bin/env bash
# Feeds a builder's guest that runs somewhere else, for as long as this is left running:
#
#   builder/feed ADDRESS DIR [--hold | --button KEY.pem]          (from evm/)
#
# It runs builder/shadow against the guest at ADDRESS an hour of slots at a time (300), live, the guest
# posting its blocks itself to the four relays its image has, unpaid; with --hold, posting to none. Each
# hour has a record of its own in DIR, named by when it began, and with it the guest's keys and the quotes
# of them, which are asked for once for each time the guest starts. After each hour one line says what
# the hour was: slots, blocks, what our node made of them, what the relays answered.
#
# It stops by itself, leaving DIR/STOPPED saying why, when something is wrong that a person should look at
# before another bid goes out: more than one in twenty of the answers from relays were refusals, or more
# than one in twenty of the blocks sent were not judged valid by the node here. That is looked at once a
# minute over the last fifty slots, and over the whole hour at its end. A guest that cannot be reached is
# tried again every minute. A guest whose key for bids is no longer the one docs/live names (it began
# again) is said after each hour and noted in DIR/BEGAN-AGAIN; the feed goes on. A block of ours that
# becomes the chain's head ends that hour's run early, as builder/shadow does, and the next begins.
#
# With --button KEY.pem a person can have bids paid up for a few slots: builder/press writes a press into
# DIR/button.jsonl, and builder/shadow, which is given the wallet's key for that, signs a payment to the
# proposer into each block of the slots the press names, until one is taken. Without a press nothing is
# signed. The limits (0.01 ETH a press, 0.05 ETH in 24 hours) are builder/shadow's, and its heading says
# what they rest on. Without --button this program is given no key that can pay.
#
# Requests that were slow are kept whole by builder/shadow (DIR/slow), megabytes each: those older than a
# day are removed here.
#
# This is the untrusted host's side. It never goes in an image.
set -uo pipefail
usage() { echo "usage: builder/feed ADDRESS DIR [--hold | --button KEY.pem]" >&2; exit 2; }
[[ $# -ge 2 ]] || usage
address="$1"; dir="$2"; hold=""; button=()
case "${3:-}" in
  "") [[ $# -eq 2 ]] || usage ;;
  --hold) [[ $# -eq 3 ]] || usage; hold=--hold ;;
  --button) [[ $# -eq 4 && -r "$4" ]] || usage; button=(--button "$dir/button.jsonl" --wallet "$4") ;;
  *) usage ;;
esac
here="$(cd "$(dirname "$0")/.." && pwd)"
relays=https://boost-relay.flashbots.net,https://relay-builders-us.ultrasound.money,https://aestus.live,https://us-global.titanrelay.xyz
mkdir -p "$dir"
cd "$here"
# What a record says so far. `hour` prints the line for a finished hour and judges all of it; `watch` judges
# the last fifty slots and says nothing unless it stops the feed. Fails when the feed should stop.
look() {
  python3 -I - "$@" <<'PY'
import collections, json, statistics, sys
log, stopped, how = sys.argv[1:4]
rows = []
for line in open(log):
    try:
        rows.append(json.loads(line))
    except ValueError:
        pass                                    # the line being written
if not rows:
    sys.exit(0)
judging = rows if how == "hour" else rows[-50:]
def account(rows):
    rounds = [x for r in rows for x in r.get("rounds") or []]
    judged = collections.Counter(str(x.get("judged"))[:40] for x in rounds if x.get("judged") is not None)
    answers = collections.Counter()
    for x in rounds:
        for status, text in x.get("relay") or []:
            answers["took it" if status in (200, 202) else "no answer" if status == "no answer" else f"refused ({status}): {text.strip()[:60]}"] += 1
    return rounds, judged, answers
rounds, judged, answers = account(rows)
if how == "hour":
    print(f"feed: {len(rows)} slots from block {rows[0]['number']}, {len(rounds)} blocks ({statistics.median(len(r.get('rounds') or []) for r in rows)} a slot), "
          f"judged here {dict(judged)}; relays: {dict(answers) or 'none asked'}; guest replaced {max((r.get('guest_replaced') or 0) for r in rows)} times; "
          f"landed {[r['number'] for r in rows if r.get('landed')]}", flush=True)
rounds, judged, answers = account(judging)
total, refused = sum(answers.values()), sum(n for what, n in answers.items() if what.startswith("refused"))
looked, wrong = sum(judged.values()), sum(n for what, n in judged.items() if what != "valid")
why = ""
if total >= 40 and refused * 20 > total:
    why = f"{refused} of {total} answers from relays were refusals: {dict(answers)}"
elif looked >= 20 and wrong * 20 > looked:
    why = f"{wrong} of {looked} blocks were not judged valid by the node here: {dict(judged)}"
if why:
    with open(stopped, "w") as f:
        f.write(f"{why}\n(the last {len(judging)} slots of {log})\n")
    print(f"feed: stopping: {why}", flush=True)
    sys.exit(1)
PY
}
while true; do
  if [[ -e "$dir/STOPPED" ]]; then
    echo "feed: stopped earlier, and $dir/STOPPED says why; remove it to go on"
    exit 0
  fi
  log="$dir/$(date -u +%Y%m%d-%H%M%S).jsonl"
  # shellcheck disable=SC2086
  python3 -I builder/shadow --guest "$address" --live --guest-sends $hold --rebid --ready 0.7 --finishing 0.25 \
    --relay-wait 1500 --relays "$relays" --slots 300 --log "$log" "${button[@]}" > /dev/null 2> "$log.err" &
  child=$!
  trap 'kill "$child" 2>/dev/null' EXIT
  waited=0
  while kill -0 "$child" 2>/dev/null; do
    sleep 2
    waited=$((waited + 2))
    if [[ $waited -ge 60 ]]; then
      waited=0
      if [[ -s "$log" ]] && ! look "$log" "$dir/STOPPED" watch; then
        kill "$child" 2>/dev/null
        wait "$child" 2>/dev/null
        exit 0
      fi
    fi
  done
  wait "$child"
  status=$?
  trap - EXIT
  if [[ ! -s "$log" ]]; then
    echo "feed: nothing came of a run against $address (exit $status): $(tail -n 1 "$log.err" 2>/dev/null | cut -c1-200)"
    rm -f "$log" "$log.err"
    sleep 60
    continue
  fi
  [[ -s "$log.err" ]] || rm -f "$log.err"
  look "$log" "$dir/STOPPED" hour || exit 0
  # A guest that began again has new keys, and what docs/live says is then of one that is gone: said
  # here and noted in DIR/BEGAN-AGAIN, for scripts/gce-live to be run on the record named.
  newest="$(ls -t "$log".keys*.json 2>/dev/null | head -n 1)"
  if [[ -n "$newest" && -e "$here/../docs/live/builder.json" ]] && ! python3 -I -c '
import json, sys
sys.exit(json.load(open(sys.argv[1])).get("builder") != json.load(open(sys.argv[2])).get("builder"))' \
      "$newest" "$here/../docs/live/builder.json" 2>/dev/null; then
    echo "feed: the guest's key for bids is not the one docs/live names; the record of it now is $newest"
    echo "$(date -u +'%Y-%m-%d %H:%M UTC') $newest" >> "$dir/BEGAN-AGAIN"
  fi
  find "$dir/slow" -type f -mmin +1440 -delete 2>/dev/null
done
