#!/usr/bin/env python3
"""Builds a block in the guest for every slot of the chain a node follows, and has the node judge it.

    builder/shadow [--slots N] [--gas G] [--process] [--log FILE]        (from evm/)

Nothing here is signed and nothing is sent to a relay: this is the builder run in shadow, to find out
whether what the guest builds from pending transactions is valid and whether it is ready in time.

For each new head it gathers what the next slot fixes (from the consensus node: randomness, withdrawals,
the parent beacon root; from a relay's public list: the proposer's fee recipient and registered gas limit),
takes pending transactions from the execution node's pool, has that node trace them to learn what state
they touch and prove that state at the head, and puts the lot to the guest as a request to build
(Evm/Build.lean). What comes back is made into a bid submission and handed to the execution node's own
validator, `flashbots_validateBuilderSubmissionV5`, which is the code relays run. When the real next block
arrives, the slot inputs that were guessed are compared with what it had.

This program is the untrusted host. It never goes in an image.

  --slots N    stop after N slots (default: run until interrupted)
  --gas G      the most gas the guest is asked to fill (default 12000000)
  --process    put requests to .lake/build/bin/evm-serve-min instead of a guest in a trust domain
  --log FILE   one line of JSON a slot (default /data/eth/shadow/shadow.jsonl)

Settings in the environment: SHADOW_RPC (http://127.0.0.1:8545), SHADOW_BEACON (http://127.0.0.1:5052),
SHADOW_RELAY (https://boost-relay.flashbots.net), SILO_TDVF and SILO_HOST_PORT (5035) for the guest.
"""
import json, os, shutil, signal, socket, struct, subprocess, sys, time, urllib.request
from concurrent.futures import ThreadPoolExecutor

args = sys.argv[1:]
def option(name, default=None, flag=False):
    if name in args:
        i = args.index(name)
        if flag:
            del args[i]
            return True
        value = args[i + 1]
        del args[i:i + 2]
        return value
    return False if flag else default
slots_wanted = int(option("--slots", "0"))
gas_cap = int(option("--gas", "12000000"))
as_process = option("--process", flag=True)
log_path = option("--log", "/data/eth/shadow/shadow.jsonl")
if args:
    sys.exit(__doc__)

RPC = os.environ.get("SHADOW_RPC", "http://127.0.0.1:8545")
BEACON = os.environ.get("SHADOW_BEACON", "http://127.0.0.1:5052")
RELAY = os.environ.get("SHADOW_RELAY", "https://boost-relay.flashbots.net")
here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
system = os.path.dirname(here)
GENESIS_TIME = 1606824023
EMPTY_OMMERS = bytes.fromhex("1dcc4de8dec75d7aab85b567b6ccd41ad312451b948a7413f0a142fd40d49347")
SYSTEM = "0xfffffffffffffffffffffffffffffffffffffffe"
SYSTEM_CONTRACTS = {
    "beacon": "0x000f3df6d732807ef1319fb7b8bb8522d0beac02",
    "history": "0x0000f90827f1c53a10cb7a02335b175320002935",
    "withdrawals": "0x00000961ef480eb55e80d19ad83579a64c007002",
    "consolidations": "0x0000bbddc7ce488642fb579f8b00f3a590007251",
}

# ---- talking to the nodes -------------------------------------------------------------------------

def post(body, timeout=60):
    request = urllib.request.Request(RPC, json.dumps(body).encode(), {"Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.load(response)

def rpc(method, params, timeout=60):
    answer = post({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}, timeout)
    if "error" in answer:
        raise RuntimeError(f"{method}: {answer['error'].get('message', answer['error'])}")
    return answer["result"]

def batch(calls, workers=16, size=20):
    """Many (method, params), answered in order; errors come back as None."""
    chunks = [calls[i:i + size] for i in range(0, len(calls), size)]
    def one(chunk):
        body = [{"jsonrpc": "2.0", "id": i, "method": m, "params": p} for i, (m, p) in enumerate(chunk)]
        answers = sorted(post(body), key=lambda a: a["id"])
        return [a.get("result") for a in answers]
    with ThreadPoolExecutor(workers) as pool:
        return [r for part in pool.map(one, chunks) for r in part]

def get(base, path, timeout=20):
    request = urllib.request.Request(base + path, headers={"Accept": "application/json", "User-Agent": "builder-shadow"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.load(response)

def raw(text):
    return bytes.fromhex(text[2:])

# ---- RLP ------------------------------------------------------------------------------------------

def rlp(item):
    if isinstance(item, int):
        item = item.to_bytes((item.bit_length() + 7) // 8, "big")
    if isinstance(item, (bytes, bytearray)):
        if len(item) == 1 and item[0] < 0x80:
            return bytes(item)
        return length(len(item), 0x80) + bytes(item)
    payload = b"".join(rlp(x) for x in item)
    return length(len(payload), 0xc0) + payload

def length(n, base):
    if n <= 55:
        return bytes([base + n])
    digits = n.to_bytes((n.bit_length() + 7) // 8, "big")
    return bytes([base + 55 + len(digits)]) + digits

def unrlp(data, at=0):
    """The item at `at`, and where the next one starts."""
    first = data[at]
    if first < 0x80:
        return data[at:at + 1], at + 1
    if first <= 0xb7:
        n = first - 0x80
        return data[at + 1:at + 1 + n], at + 1 + n
    if first <= 0xbf:
        k = first - 0xb7
        n = int.from_bytes(data[at + 1:at + 1 + k], "big")
        return data[at + 1 + k:at + 1 + k + n], at + 1 + k + n
    if first <= 0xf7:
        start, n = at + 1, first - 0xc0
    else:
        k = first - 0xf7
        start, n = at + 1 + k, int.from_bytes(data[at + 1:at + 1 + k], "big")
    items, pos = [], start
    while pos < start + n:
        item, pos = unrlp(data, pos)
        items.append(item)
    return items, start + n

# ---- the guest ------------------------------------------------------------------------------------

class Guest:
    def __init__(self):
        self.process = None
        self.boots = 0
        if not as_process:
            self.port = int(os.environ.get("SILO_HOST_PORT", "5035"))
            self.boot()

    def boot(self):
        image = os.path.join(here, ".lake/build/efi/tdx/evm-os/BOOTX64.EFI")
        slot = os.path.join(system, ".lake/build/efi/tdx/evm-os")
        os.makedirs(slot, exist_ok=True)
        shutil.copyfile(image, os.path.join(slot, "BOOTX64.EFI"))
        self.serial = os.path.join("/data/eth/shadow", "serial.log")
        self.process = subprocess.Popen(
            [os.path.join(system, "scripts/run-efi"), "tdx", "evm-os"], cwd=system,
            env=dict(os.environ, SILO_HOST_PORT=str(self.port)),
            stdout=open(self.serial, "wb"), stderr=subprocess.STDOUT, start_new_session=True)
        started = time.time()
        while b"serving TCP 5005" not in open(self.serial, "rb").read():
            if self.process.poll() is not None or time.time() - started > 120:
                sys.exit("shadow: the guest did not come up")
            time.sleep(0.25)
        self.boots += 1

    def ask(self, request, patience=40):
        if as_process:
            done = subprocess.run([os.path.join(here, ".lake/build/bin/evm-serve-min")], input=request,
                                  capture_output=True, timeout=patience)
            return done.stdout
        try:
            with socket.create_connection(("127.0.0.1", self.port), timeout=10) as s:
                s.settimeout(patience)
                s.sendall(struct.pack(">I", len(request)) + request)
                got = b""
                while len(got) < 4 or len(got) < 4 + struct.unpack(">I", got[:4])[0]:
                    piece = s.recv(65536)
                    if not piece:
                        break
                    got += piece
                return got[4:]
        except OSError:
            # A guest that has stopped answering is replaced; the slot it was asked about is lost.
            self.stop()
            self.boot()
            return b""

    def stop(self):
        if self.process:
            try:
                os.killpg(self.process.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            self.process.wait(timeout=20)

# ---- one slot -------------------------------------------------------------------------------------

headers = {}          # block number -> raw header, the last 255 kept
codes = {}            # code hash -> code
duties = {"fetched": 0, "by_slot": {}}

def proposer(slot):
    """The fee recipient, registered gas limit and key of whoever proposes `slot`, if the relay knows."""
    if time.time() - duties["fetched"] > 300 or slot not in duties["by_slot"]:
        try:
            listed = get(RELAY, "/relay/v1/builder/validators")
            duties["by_slot"] = {int(d["slot"]): d["entry"]["message"] for d in listed}
        except Exception:
            pass
        duties["fetched"] = time.time()
    return duties["by_slot"].get(slot)

def gas_limit_towards(parent, wanted):
    step = max(parent // 1024 - 1, 0)
    return min(parent + step, wanted) if wanted > parent else max(parent - step, wanted)

def tip_of(tx, base_fee):
    if tx["type"] in ("0x0", "0x1"):
        price = int(tx["gasPrice"], 16)
        return price - base_fee if price >= base_fee else None
    cap, tip = int(tx["maxFeePerGas"], 16), int(tx["maxPriorityFeePerGas"], 16)
    return min(tip, cap - base_fee) if cap >= base_fee else None

def candidates(base_fee, budget):
    """Pending transactions, best paying first with each signer's in nonce order, up to `budget` gas."""
    pending = rpc("txpool_content", [])["pending"]
    queues = {}
    for sender, by_nonce in pending.items():
        run = []
        for nonce in sorted(by_nonce, key=int):
            tx = by_nonce[nonce]
            tip = tip_of(tx, base_fee)
            if tx["type"] == "0x3" or tip is None:
                break
            run.append((tip, tx))
        if run:
            queues[sender] = run
    chosen, gas = [], 0
    while queues and gas < budget and len(chosen) < 400:
        sender = max(queues, key=lambda s: queues[s][0][0])
        tip, tx = queues[sender].pop(0)
        if not queues[sender]:
            del queues[sender]
        chosen.append(tx)
        gas += int(tx["gas"], 16)
    return chosen

def call_of(tx):
    call = {"from": tx["from"], "gas": tx["gas"], "value": tx["value"], "input": tx["input"], "nonce": tx["nonce"]}
    if tx.get("to"):
        call["to"] = tx["to"]
    priced = ("gasPrice",) if tx["type"] in ("0x0", "0x1") else ("maxFeePerGas", "maxPriorityFeePerGas")
    for field in priced + ("accessList", "authorizationList"):
        if tx.get(field) is not None:
            call[field] = tx[field]
    return call

def touched_by(txs, override, at):
    """What state the transactions read when run one after another on the head, and which of them clear
    a storage slot. A transaction the node cannot trace is left out."""
    touched, kept = {}, []
    options = {"tracer": "prestateTracer"}
    diff = {"tracer": "prestateTracer", "tracerConfig": {"diffMode": True}}
    calls = [call_of(tx) for tx in txs]
    try:
        context = {"blockNumber": at}
        plain = rpc("debug_traceCallMany", [[{"transactions": calls, "blockOverride": override}], context, options])[0]
        diffed = rpc("debug_traceCallMany", [[{"transactions": calls, "blockOverride": override}], context, diff])[0]
    except Exception as error:
        return None, [], str(error)
    for tx, before, change in zip(txs, plain, diffed):
        if not isinstance(before, dict) or not isinstance(change, dict) or "pre" not in change:
            continue
        clears = any(slot not in ((change["post"].get(address) or {}).get("storage") or {})
                     and int(value, 16) != 0
                     for address, account in change["pre"].items()
                     for slot, value in (account.get("storage") or {}).items())
        if clears:
            continue
        kept.append(tx)
        for address, account in before.items():
            touched.setdefault(address.lower(), set()).update((account.get("storage") or {}).keys())
    return touched, kept, ""

def system_touches(touched, number, timestamp, at):
    """What the block's own calls read before and after its transactions."""
    ring = 8191
    touched.setdefault(SYSTEM_CONTRACTS["beacon"], set()).update(
        {"0x%064x" % (timestamp % ring), "0x%064x" % (timestamp % ring + ring)})
    touched.setdefault(SYSTEM_CONTRACTS["history"], set()).add("0x%064x" % ((number - 1) % ring))
    for name in ("withdrawals", "consolidations"):
        contract = SYSTEM_CONTRACTS[name]
        try:
            before = rpc("debug_traceCall", [{"from": SYSTEM, "to": contract, "gas": hex(30_000_000)}, at,
                                             {"tracer": "prestateTracer"}])
            slots = set(((before.get(contract) or {}).get("storage") or {}).keys())
        except Exception:
            slots = set()
        touched.setdefault(contract, set()).update(slots | {"0x%064x" % i for i in range(4)})
    touched.setdefault(SYSTEM, set())

def build_one(guest, head, log):
    t0 = time.time()
    parent_at = head["number"]      # everything about the state is asked of the parent block, by number
    number = int(head["number"], 16) + 1
    parent_time = int(head["timestamp"], 16)
    timestamp = parent_time + 12
    slot = (timestamp - GENESIS_TIME) // 12
    record = {"number": number, "slot": slot, "parent": head["hash"], "arrived": round(t0 - parent_time, 2)}

    # What the slot fixes.
    beacon_head = get(BEACON, "/eth/v1/beacon/headers/head")["data"]
    beacon_root = beacon_head["root"]
    randao = get(BEACON, "/eth/v1/beacon/states/head/randao")["data"]["randao"]
    withdrawals = get(BEACON, "/eth/v1/builder/states/head/expected_withdrawals")["data"]
    duty = proposer(slot)
    record["registered"] = duty is not None
    fee_recipient = duty["fee_recipient"] if duty else "0x8aed888c51f20d5d028039674e7e085a108c92dd"
    registered = int(duty["gas_limit"]) if duty else int(head["gasLimit"], 16)
    proposer_key = duty["pubkey"] if duty else "0x" + "00" * 48
    gas_limit = gas_limit_towards(int(head["gasLimit"], 16), registered)

    # The 255 headers before the block, oldest first.
    wanted = range(max(0, number - 255), number)
    missing = [n for n in wanted if n not in headers]
    for n, header in zip(missing, batch([("debug_getRawHeader", [hex(n)]) for n in missing])):
        headers[n] = raw(header)
    for n in [n for n in headers if n < number - 255]:
        del headers[n]

    # What is proposed, and what it touches.
    base_fee = int(rpc("eth_feeHistory", [1, parent_at, []])["baseFeePerGas"][-1], 16)
    proposed = candidates(base_fee, 2 * gas_cap)
    record["pending"] = len(proposed)
    override = {"number": hex(number), "time": hex(timestamp), "gasLimit": hex(gas_limit),
                "feeRecipient": fee_recipient, "prevRandao": randao, "baseFeePerGas": hex(base_fee)}
    touched, kept, why = touched_by(proposed, override, parent_at)
    if touched is None:
        record["skipped"] = "trace: " + why
        return record
    record["proposed"] = len(kept)
    system_touches(touched, number, timestamp, parent_at)
    for address in [fee_recipient] + [w["address"] for w in withdrawals] + [tx["from"] for tx in kept] + \
                   [tx["to"] for tx in kept if tx.get("to")]:
        touched.setdefault(address.lower(), set())
    t1 = time.time()

    # Proofs and code at the head, and the transactions as they go on the wire.
    addresses = sorted(touched)
    proofs = batch([("eth_getProof", [a, sorted(touched[a]), parent_at]) for a in addresses], workers=32, size=5)
    for i, a in enumerate(addresses):
        if proofs[i] is None:       # asked once more, alone
            try:
                proofs[i] = rpc("eth_getProof", [a, sorted(touched[a]), parent_at])
            except RuntimeError:
                pass
    if any(p is None for p in proofs):
        record["skipped"] = "the node would not prove the parent's state"
        return record
    # A transaction the pool has let go of since it was listed is not proposed.
    raws = batch([("eth_getRawTransactionByHash", [tx["hash"]]) for tx in kept])
    kept = [tx for tx, r in zip(kept, raws) if r]
    raws = [r for r in raws if r]
    record["proposed"] = len(kept)
    new_code = [a for a, p in zip(addresses, proofs) if p["codeHash"] not in codes]
    for a, code in zip(new_code, batch([("eth_getCode", [a, parent_at]) for a in new_code])):
        codes[dict(zip(addresses, proofs))[a]["codeHash"]] = raw(code or "0x")
    nodes = set()
    for proof in proofs:
        nodes.update(proof["accountProof"])
        for storage in proof["storageProof"]:
            nodes.update(storage["proof"])
    keys = [raw(a) for a in addresses] + [raw(s) for a in addresses for s in sorted(touched[a])]
    t2 = time.time()

    # The request.
    def tx_item(data):
        return unrlp(data)[0] if data[0] >= 0xc0 else data
    template_header = [raw(head["hash"]), EMPTY_OMMERS, raw(fee_recipient), bytes(32), bytes(32), bytes(32),
                       bytes(256), 0, number, gas_limit, 0, timestamp, b"cluck", raw(randao), bytes(8),
                       0, bytes(32), 0, 0, raw(beacon_root), bytes(32)]
    wire = [raw(r) for r in raws]
    block = rlp([template_header, [tx_item(w) for w in wire], [],
                 [[int(w["index"]), int(w["validator_index"]), raw(w["address"]), int(w["amount"])]
                  for w in withdrawals]])
    sized = lambda data: struct.pack(">I", len(data)) + data
    listed = lambda items: struct.pack(">I", len(items)) + b"".join(sized(i) for i in items)
    code_list = sorted({codes[p["codeHash"]] for p in proofs if codes.get(p["codeHash"])})
    request = (b"JBLD1" + bytes([255]) + struct.pack(">Q", 1) + bytes([1]) + struct.pack(">Q", gas_cap) +
               sized(block) + listed([headers[n] for n in wanted]) + listed([raw(n) for n in sorted(nodes)]) +
               listed(code_list) + listed(keys))
    record["request_bytes"] = len(request)
    reply = guest.ask(request)
    t3 = time.time()
    record["seconds"] = {"inputs_and_trace": round(t1 - t0, 2), "proofs": round(t2 - t1, 2),
                         "guest": round(t3 - t2, 2), "total": round(t3 - t0, 2)}
    record["ready_before_slot"] = round(timestamp - t3, 2)
    if not reply or reply[0] != 0:
        record["status"] = reply[0] if reply else -1
        record["lacking"] = reply[1:33].hex() if len(reply) >= 33 else ""
        # Kept whole, for `build-why`.
        kept_dir = os.path.join(os.path.dirname(log_path), "unbuilt")
        os.makedirs(kept_dir, exist_ok=True)
        with open(os.path.join(kept_dir, f"{number}.req"), "wb") as f:
            f.write(request)
        return record

    # What was built, as a bid.
    block_hash, state_root = reply[1:33], reply[33:65]
    value = int.from_bytes(reply[65:97], "big")
    gas_used = struct.unpack(">Q", reply[97:105])[0]
    count = struct.unpack(">I", reply[105:109])[0]
    places = struct.unpack(f">{count}I", reply[109:109 + 4 * count])
    at = 109 + 4 * count
    header_size = struct.unpack(">I", reply[at:at + 4])[0]
    header, _ = unrlp(reply[at + 4:at + 4 + header_size])
    at += 4 + header_size
    made = []
    for _ in range(struct.unpack(">I", reply[at:at + 4])[0]):
        n = struct.unpack(">I", reply[at + 4:at + 8])[0]
        made.append(reply[at + 8:at + 8 + n])
        at += 4 + n
    at += 4
    number_of = lambda item: str(int.from_bytes(item, "big"))
    hexed = lambda item: "0x" + item.hex()
    payload = {
        "parent_hash": hexed(header[0]), "fee_recipient": hexed(header[2]), "state_root": hexed(header[3]),
        "receipts_root": hexed(header[5]), "logs_bloom": hexed(header[6]), "prev_randao": hexed(header[13]),
        "block_number": number_of(header[8]), "gas_limit": number_of(header[9]), "gas_used": number_of(header[10]),
        "timestamp": number_of(header[11]), "extra_data": hexed(header[12]), "base_fee_per_gas": number_of(header[15]),
        "block_hash": hexed(block_hash), "transactions": [hexed(wire[i]) for i in places],
        "withdrawals": [{"index": w["index"], "validator_index": w["validator_index"], "address": w["address"],
                         "amount": w["amount"]} for w in withdrawals],
        "blob_gas_used": number_of(header[17]), "excess_blob_gas": number_of(header[18])}
    requests = {"deposits": [], "withdrawals": [], "consolidations": []}
    little = lambda data: str(int.from_bytes(data, "little"))
    for item in made:
        kind, data = item[0], item[1:]
        if kind == 0:
            for i in range(0, len(data), 192):
                d = data[i:i + 192]
                requests["deposits"].append({"pubkey": hexed(d[:48]), "withdrawal_credentials": hexed(d[48:80]),
                    "amount": little(d[80:88]), "signature": hexed(d[88:184]), "index": little(d[184:192])})
        elif kind == 1:
            for i in range(0, len(data), 76):
                d = data[i:i + 76]
                requests["withdrawals"].append({"source_address": hexed(d[:20]), "validator_pubkey": hexed(d[20:68]),
                    "amount": little(d[68:76])})
        elif kind == 2:
            for i in range(0, len(data), 116):
                d = data[i:i + 116]
                requests["consolidations"].append({"source_address": hexed(d[:20]), "source_pubkey": hexed(d[20:68]),
                    "target_pubkey": hexed(d[68:116])})
    submission = {
        "message": {"slot": str(slot), "parent_hash": head["hash"], "block_hash": hexed(block_hash),
                    "builder_pubkey": "0x" + "00" * 48, "proposer_pubkey": proposer_key,
                    "proposer_fee_recipient": fee_recipient, "gas_limit": str(gas_limit), "gas_used": str(gas_used),
                    "value": str(value)},
        "execution_payload": payload,
        "blobs_bundle": {"commitments": [], "proofs": [], "blobs": []},
        "execution_requests": requests,
        "signature": "0x" + "00" * 96,
        "registered_gas_limit": str(registered),
        "parent_beacon_block_root": beacon_root}
    record.update({"status": 0, "hash": hexed(block_hash), "went_in": count, "gas_used": gas_used,
                   "value_eth": value / 1e18, "randao": randao,
                   "withdrawals": [w["index"] for w in withdrawals]})
    try:
        rpc("flashbots_validateBuilderSubmissionV5", [submission])
        record["judged"] = "valid"
    except RuntimeError as error:
        record["judged"] = str(error)[:300]
        # Kept whole for whoever looks into it: the request, the reply and what the node said.
        kept_dir = os.path.join(os.path.dirname(log_path), "refused")
        os.makedirs(kept_dir, exist_ok=True)
        with open(os.path.join(kept_dir, f"{number}.req"), "wb") as f:
            f.write(request)
        with open(os.path.join(kept_dir, f"{number}.reply"), "wb") as f:
            f.write(reply)
        with open(os.path.join(kept_dir, f"{number}.json"), "w") as f:
            json.dump({"submission": submission, "said": str(error),
                       "transactions": [kept[i]["hash"] for i in places]}, f)
    record["seconds"]["judge"] = round(time.time() - t3, 2)
    return record

def main():
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    guest = Guest()
    log = open(log_path, "a")
    seen, done, last = None, 0, None
    try:
        while not slots_wanted or done < slots_wanted:
            head = rpc("eth_getBlockByNumber", ["latest", False])
            if head["hash"] == seen:
                time.sleep(0.1)
                continue
            seen = head["hash"]
            # The slot inputs guessed for the block that has just arrived, against what it had.
            if last and last.get("number") == int(head["number"], 16) and "randao" in last:
                last["randao_right"] = head["mixHash"] == last["randao"]
                last["withdrawals_right"] = \
                    [int(w["index"], 16) for w in head.get("withdrawals", [])] == [int(i) for i in last["withdrawals"]]
            if last:
                last.pop("randao", None), last.pop("withdrawals", None)
                log.write(json.dumps(last) + "\n")
                log.flush()
                print(json.dumps(last), flush=True)
            try:
                last = build_one(guest, head, log)
            except Exception as error:
                last = {"number": int(head["number"], 16) + 1, "skipped": f"{type(error).__name__}: {error}"[:300]}
            done += 1
    finally:
        if last:
            last.pop("randao", None), last.pop("withdrawals", None)
            log.write(json.dumps(last) + "\n")
            print(json.dumps(last), flush=True)
        guest.stop()

main()
