def learn_duties():
    """Each relay's list of who proposes the coming slots and what they registered with it."""
    def one(relay):
        try:
            listed = get(relay, "/relay/v1/builder/validators")
            return relay, {int(d["slot"]): d["entry"]["message"] for d in listed}
        except Exception:
            return relay, None
    with ThreadPoolExecutor(len(RELAYS)) as pool:
        for relay, by_slot in pool.map(one, RELAYS):
            if by_slot is not None:
                duties[relay] = by_slot

def keep_learning():
    while True:
