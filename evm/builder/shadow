def follow(guest, head):
    """The chain's newest block shown to the guest, with the node's own witness for it (Evm/Follow.lean):
    whether the guest took it. Any block between the last one shown and this one is shown first."""
    number = int(head["number"], 16)
    first = number if followed["number"] is None or number - followed["number"] > 3 else followed["number"] + 1
    for n in range(first, number + 1):
        began = time.time()
        name = hex(n)
        witness, body, block = batch([("debug_executionWitness", [name]), ("debug_getRawBlock", [name]),
                                      ("eth_getBlockByNumber", [name, False])], workers=3, size=1)
        before, want = [], block["parentHash"]
        for _ in range(min(255, n)):
            if want not in shown_headers:
                shown_headers[want] = raw(rpc("debug_getRawHeader", [want]))
            before.append(shown_headers[want])
            want = "0x" + unrlp(shown_headers[want])[0][0].hex()
        before.reverse()
        if len(shown_headers) > 600:
            for stale in list(shown_headers)[:len(shown_headers) - 300]:
                del shown_headers[stale]
        addresses = [k for k in witness.get("keys") or [] if len(k) == 42]
        codes = {raw(c) for c in witness["codes"]}
        codes |= {raw(c) for c in batch([("eth_getCode", [a, hex(n - 1)]) for a in addresses], workers=32, size=20) if c}
        codes.discard(b"")
        sized = lambda data: struct.pack(">I", len(data)) + data
        listed = lambda items: struct.pack(">I", len(items)) + b"".join(sized(i) for i in items)
        request = (b"JFOL1" + bytes([255]) + struct.pack(">Q", 1) + sized(raw(body)) + listed(before) +
                   listed([raw(node) for node in witness["state"]]) + listed(sorted(codes)) + listed([]))
        answer = guest.ask(request)
        if answer[:1] != b"\0":
            followed["number"], followed["run"] = None, 0
            return False, f"block {n}: status {answer[:1].hex()}"
        followed["number"] = n
        followed["run"] = followed.get("run", 0) + 1
        followed["seconds"].append(round(time.time() - began, 2))
    return True, ""

