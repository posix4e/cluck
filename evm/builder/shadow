class Guest:
    def __init__(self):
        import threading
        self.process = None
        self.boots = 0
        self.link = None                  # the one connection kept to a guest somewhere else
        self.links = 0                    # how many such connections there have been
        self.asking = threading.Lock()    # one request at a time on it
        if remote:
            host, _, port = remote.rpartition(":") if ":" in remote else (remote, "", "")
            self.where = (host, int(port or 5005))
            self.boots = 1
        elif not as_process:
            self.port = int(os.environ.get("SILO_HOST_PORT", "5035"))
            self.boot()

    def ask_there(self, request, patience):
        """A request put to a guest somewhere else on the connection kept for it. A connection that
        fails loses the request: the next one makes a new connection."""
        with self.asking:
            try:
                if self.link is None:
                    self.link = socket.create_connection(self.where, timeout=10)
                    self.link.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
                    self.links += 1
                self.link.settimeout(patience)
                self.link.sendall(struct.pack(">I", len(request)) + request)
                got = b""
                while len(got) < 4 or len(got) < 4 + struct.unpack(">I", got[:4])[0]:
                    piece = self.link.recv(1 << 20)
                    if not piece:
                        raise ConnectionError("the guest closed the connection")
                    got += piece
                return got[4:]
            except OSError:
                if self.link is not None:
                    self.link.close()
                self.link = None
                return b""

    def boot(self):
        # The image that is meant, or, when the guest is to send its blocks to the stand-in relay, the
        # one that believes the stand-in.
        name = image_name
        image = os.path.join(here, ".lake/build/efi/tdx", name, "BOOTX64.EFI")
        slot = os.path.join(system, ".lake/build/efi/tdx", name)
        os.makedirs(slot, exist_ok=True)
        shutil.copyfile(image, os.path.join(slot, "BOOTX64.EFI"))
        self.serial = log_path + ".serial"
        # A guest that is being replaced leaves its console behind, for whoever asks why it stopped.
        if self.boots and os.path.exists(self.serial):
            os.replace(self.serial, f"{self.serial}.{self.boots}")
            if os.path.exists(log_path + ".pcap"):
                os.replace(log_path + ".pcap", f"{log_path}.pcap.{self.boots}")
        # With a sealed transaction about, every frame of the guest's is written down, to be searched.
        watched = {"SILO_NET_DUMP": log_path + ".pcap"} if sealed or frames_kept else {}
        self.process = subprocess.Popen(
            [os.path.join(system, "scripts/run-efi"), "tdx", name], cwd=system,
            env=dict(os.environ, SILO_HOST_PORT=str(self.port), **watched),
            stdout=open(self.serial, "wb"), stderr=subprocess.STDOUT, start_new_session=True)
        started = time.time()
        while b"serving TCP 5005" not in open(self.serial, "rb").read():
            if self.process.poll() is not None or time.time() - started > 120:
                sys.exit("shadow: the guest did not come up")
            time.sleep(0.25)
        self.boots += 1

    def ask(self, request, patience=40):
        if remote:
            return self.ask_there(request, patience)
        if as_process:
            done = subprocess.run([os.path.join(here, ".lake/build/bin/evm-serve-min")], input=request,
                                  capture_output=True, timeout=patience)
            return done.stdout
        try:
            with socket.create_connection(("127.0.0.1", self.port), timeout=10) as s:
                s.settimeout(patience)
                s.sendall(struct.pack(">I", len(request)) + request)
                got = b""
                while len(got) < 4 or len(got) < 4 + struct.unpack(">I", got[:4])[0]:
                    piece = s.recv(65536)
                    if not piece:
                        break
                    got += piece
                # What the host has now seen. A sealed transaction must be in none of it; and when it
                # brought its own proofs, neither must what it touches.
                sealing["host_saw"] += sum(mark in request or mark in got for mark in sealing["marks"])
                sealing["host_saw_about"] += sum(mark in request or mark in got for mark in sealing["about"])
                return got[4:]
        except OSError:
            # A guest that has stopped answering is replaced; the slot it was asked about is lost.
            self.stop()
            self.boot()
            return b""

    def stop(self):
        if self.process:
            try:
                os.killpg(self.process.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            self.process.wait(timeout=20)

