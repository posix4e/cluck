def proposer(slot):
    """The fee recipient, registered gas limit and key of whoever proposes `slot`, as the first relay that
    knows has it, and the relays that have it the same: a block built for one registration is no use to a
    relay holding another."""
    known = [(relay, duties[relay][slot]) for relay in RELAYS if slot in duties.get(relay, {})]
    if not known:
        return None, []
    same = lambda a, b: all(a[k].lower() == b[k].lower() for k in ("fee_recipient", "gas_limit", "pubkey"))
    return known[0][1], [relay for relay, duty in known if same(duty, known[0][1])]

def submit(relay, body, until):
    """A bid posted to a relay: the HTTP status and the start of what it said. A relay that does not yet
    know the slot's parent is asked again, twice at most."""
    for attempt in range(3):
        try:
            asked = urllib.request.Request(relay + "/relay/v1/builder/blocks", body,
                                           {"Content-Type": "application/json", "User-Agent": "builder-shadow"})
            with urllib.request.urlopen(asked, timeout=max(1.0, until - time.time())) as response:
                return [response.status, response.read(300).decode(errors="replace")]
        except urllib.error.HTTPError as error:
            said = error.read(300).decode(errors="replace")
            if "known" in said and attempt < 2 and time.time() < until - 1.5:
                time.sleep(0.5)
                continue
            return [error.code, said]
        except Exception as error:
            return [-1, f"{type(error).__name__}: {error}"[:200]]

def gas_limit_towards(parent, wanted):
    step = max(parent // 1024 - 1, 0)
    return min(parent + step, wanted) if wanted > parent else max(parent - step, wanted)

def tip_of(tx, base_fee):
    if tx["type"] in ("0x0", "0x1"):
        price = int(tx["gasPrice"], 16)
        return price - base_fee if price >= base_fee else None
    cap, tip = int(tx["maxFeePerGas"], 16), int(tx["maxPriorityFeePerGas"], 16)
    return min(tip, cap - base_fee) if cap >= base_fee else None

# The node's pending transactions as this program last knew them. The whole pool is 20 MB of JSON, nearly
# all of it transactions that cannot run yet, and takes a quarter of a second to ask for: it is asked for
# once a head, and between heads only for what has become pending since (a filter on the node).
pool = {"head": None, "filter": None, "pending": {}}

def pending_at(head_hash):
    if pool["head"] != head_hash or pool["filter"] is None:
        old = pool["filter"]
        try:
            # Before the pool is read, so that nothing falls between the two.
            pool["filter"] = rpc("eth_newPendingTransactionFilter", [])
        except Exception:
            pool["filter"] = None
        whole = rpc("txpool_content", [])["pending"]
        pool.update(head=head_hash, pending={sender.lower(): dict(by_nonce) for sender, by_nonce in whole.items()})
        if old:
            try:
                rpc("eth_uninstallFilter", [old])
            except Exception:
                pass
    else:
        # A filter is asked once and replaced, the next made before this one is read: reth's stopped
        # answering after a poll or two (it gave nothing while the pool took in thirty a second), and a
        # new one for each poll was seen to miss nothing.
        try:
            following_filter = rpc("eth_newPendingTransactionFilter", [])
            arrived = rpc("eth_getFilterChanges", [pool["filter"]])
            rpc("eth_uninstallFilter", [pool["filter"]])
            pool["filter"] = following_filter
        except Exception:
            pool["filter"] = None       # the node forgot the filter: the whole pool next time
            arrived = []
        for tx in batch([("eth_getTransactionByHash", [h]) for h in arrived]) if arrived else []:
            if tx and tx.get("blockHash") is None:
                pool["pending"].setdefault(tx["from"].lower(), {})[str(int(tx["nonce"], 16))] = tx
    return pool["pending"]

def candidates(base_fee, budget, head_hash):
    """Pending transactions, best paying first with each signer's in nonce order, up to `budget` gas."""
    pending = {sender: dict(by_nonce) for sender, by_nonce in pending_at(head_hash).items()}
    queues = {}
    for sender, by_nonce in pending.items():
        run = []
        for nonce in sorted(by_nonce, key=int):
            tx = by_nonce[nonce]
            tip = tip_of(tx, base_fee)
            if tx["type"] == "0x3" or tip is None:
                break
            run.append((tip, tx))
        if run:
            queues[sender] = run
    chosen, gas = [], 0
    while queues and gas < budget and len(chosen) < 400:
        sender = max(queues, key=lambda s: queues[s][0][0])
        tip, tx = queues[sender].pop(0)
        if not queues[sender]:
            del queues[sender]
        chosen.append(tx)
        gas += int(tx["gas"], 16)
    return chosen

# ---- how many transactions a round can carry in the time there is --------------------------------------
#
# A round costs gathering (the trace and the proofs, for each transaction not proposed before for this
# head) and the guest's work (for every transaction proposed, each round anew). When the pool fills, a
# round with everything in it can take most of a slot, and then there is one block for the slot, late or
# never: on 2026-11-25 400 pending transactions made rounds of 6 to 12 s and five slots in a row went by
# with nothing sent. So a round is given no more than fits: the first for a head half the time there is,
# so that a bid is out early, and each later one what is left. Best paying first, so what is left out
# pays least.

FIXED = 0.2                                   # seconds a round costs with nothing in it
pace = {"gather": [0.008] * 3, "guest": [0.008] * 3}       # seconds for each transaction, the last rounds'
if os.environ.get("SHADOW_PACE"):
    # To try the limit without waiting for a full pool: both costs said, and never learned.
    pace = {"gather": [float(os.environ["SHADOW_PACE"])] * 3, "guest": [float(os.environ["SHADOW_PACE"])] * 3, "fixed": True}

def each(name):
    """What a transaction has been costing: the middle one of the last three rounds, so that one round
    held up by something else (a relay that did not answer) is not believed, and a full pool is after
    two."""
    return sorted(pace[name])[len(pace[name]) // 2]

def learn_pace(fresh, proposed, gathering, guest_seconds):
    if pace.get("fixed"):
        return
    for name, count, seconds in (("gather", fresh, gathering), ("guest", proposed, guest_seconds - FIXED)):
        if count >= 20:
            pace[name] = pace[name][-2:] + [max(0.0005, seconds / count)]

def most_for(proposed, before, left, guest_each=None, floor=30):
    """How many of `proposed` (best paying first) a round begun now can carry, with `left` seconds for
    it: `before` holds the hashes proposed in an earlier round for this head, which cost no gathering
    again; `guest_each` is what the guest took for each transaction in this head's round before, when
    there was one, and otherwise the last rounds' say. Never fewer than `floor`."""
    guest_each = each("guest") if guest_each is None else guest_each
    spent, count = FIXED, 0
    for tx in proposed:
        spent += guest_each + (0 if tx["hash"] in before else each("gather"))
        if spent > left and count >= floor:
            break
        count += 1
    return count

# What is done about a block once the guest has answered and, with --guest-sends, sent it: the node's
# judgement of it and the check of its signature, a third of a second together. With --rebid and
# --guest-sends nothing waits on either, so they are done behind the next round, one block at a time and
# in order, and waited for when the slot's rounds are over and its record is written.
import queue, threading, traceback
checks = queue.Queue()
def checking():
    while True:
        work = checks.get()
        try:
            work()
        except Exception:
            traceback.print_exc()
        finally:
            checks.task_done()
threading.Thread(target=checking, daemon=True).start()

# What gathering has taken in rounds after a head's first, the last three: a head's first round proves
# every account anew, the ones after it only what has come since.
later = [0.5] * 3

def need_of(took, first):
    """Seconds a round begun now needs to have its block at the relay, going by the round before
    (`took`, the seconds of its record): what gathering took then, and what the guest took and a little
    over. After a head's first round (`first`) the gathering is not that round's but the later rounds':
    with a full pool the first proves 800 accounts in two or three seconds, the second what is new in
    half a second, and going by the first there was no second (15731104 and 15731107 on 2026-11-25: one
    bid each, five seconds before the slot)."""
    gathering = took.get("inputs_and_trace", 0.5) + took.get("proofs", 0.5)
    if first:
        gathering = min(gathering, 1.5 * sorted(later)[1])
    return gathering + 1.15 * took.get("guest", 0.6) + 0.05

def begin_at(now, due, need):
    """When the next round for the same head begins, or None for no more: now, while there is time for
    it and another after it; and when there is time for one but not safely for two, as late as it can
    be, so that the last block has the most to choose from. "Safely" is 2.3 times and not twice: a
    round outgrows the one before it by a sixth one time in ten, and begun at once with time for just
    two it left none for a second, and the slot's last block ready two seconds early."""
    if now + need > due:
        return None
    if now + 2.3 * need > due:
        return due - need
    return now

def call_of(tx):
    call = {"from": tx["from"], "gas": tx["gas"], "value": tx["value"], "input": tx["input"], "nonce": tx["nonce"]}
    if tx.get("to"):
        call["to"] = tx["to"]
    priced = ("gasPrice",) if tx["type"] in ("0x0", "0x1") else ("maxFeePerGas", "maxPriorityFeePerGas")
    for field in priced + ("accessList", "authorizationList"):
        if tx.get(field) is not None:
            call[field] = tx[field]
    return call

# Whether the node has the call that gives the trie nodes a slot's emptying needs (`debug_stateWitness`,
# which is not in reth as it is published: see evm/builder/reth-state-witness.patch). Without it a
# transaction that empties a slot is not proposed, since nobody could prove what the trie then becomes.
state_witness = {"there": None}
def has_state_witness():
    if state_witness["there"] is None:
        try:
            rpc("debug_stateWitness", [{"accounts": {}, "storages": {}}, "latest"])
            state_witness["there"] = True
        except Exception:
            state_witness["there"] = False
    return state_witness["there"]

# Precompiled contracts the guest takes seconds over, where a node takes a millisecond: the point evaluation
# of EIP-4844 (0x0a) and the BLS12-381 operations of EIP-2537 (0x0b to 0x11) are still Jaune's, on whole
# numbers of any size. One call to the first cost the guest 3 s on 2026-11-25, and the blocks of three
# slots with it. A transaction that reaches one of them is not proposed until that arithmetic is written
# for the purpose, as bn254's was. SHADOW_SLOW=none proposes them all the same.
SLOW = set() if os.environ.get("SHADOW_SLOW") == "none" else {"0x" + "0" * 38 + f"{n:02x}" for n in range(0x0a, 0x12)}
left_slow = {"count": 0}

def touched_by(txs, override, at, emptying=False):
    """What state the transactions read when run one after another on the head. A transaction the node
    cannot trace is left out, and so is one that empties a storage slot unless `emptying`; then such
    transactions are kept, and what comes back last is, for each account one of them empties a slot of,
    every slot of it the transactions write with the value it ends at (zero for one emptied), and which
    of those are emptied."""
    touched, kept, written, emptied, removed = {}, [], {}, set(), set()
    options = {"tracer": "prestateTracer"}
    diff = {"tracer": "prestateTracer", "tracerConfig": {"diffMode": True}}
    calls = [call_of(tx) for tx in txs]
    try:
        context = {"blockNumber": at}
        with ThreadPoolExecutor(2) as pool:
            plain, diffed = pool.map(lambda how: rpc("debug_traceCallMany",
                [[{"transactions": calls, "blockOverride": override}], context, how])[0], (options, diff))
    except Exception as error:
        return None, [], str(error)
    left_slow["count"] = 0
    for tx, before, change in zip(txs, plain, diffed):
        if not isinstance(before, dict) or not isinstance(change, dict) or "pre" not in change:
            continue
        if SLOW and not SLOW.isdisjoint(address.lower() for address in before):
            left_slow["count"] += 1
            continue
        clears = {(address.lower(), slot) for address, account in change["pre"].items()
                  for slot, value in (account.get("storage") or {}).items()
                  if int(value, 16) != 0 and slot not in ((change["post"].get(address) or {}).get("storage") or {})}
        if clears and not emptying:
            continue
        kept.append(tx)
        for address, account in change["post"].items():
            for slot, value in (account.get("storage") or {}).items():
                written.setdefault(address.lower(), {})[slot] = hex(int(value, 16))
                emptied.discard((address.lower(), slot))
        for address, slot in clears:
            written.setdefault(address, {})[slot] = "0x0"
            emptied.add((address, slot))
        # An account the transaction leaves with nothing is taken out of the state altogether (one swept
        # by a contract made at its address and destroyed in the same transaction, for one).
        removed.update(address.lower() for address in change["pre"] if address not in change["post"])
        removed.difference_update(address.lower() for address in change["post"])
        for address, account in before.items():
            touched.setdefault(address.lower(), set()).update((account.get("storage") or {}).keys())
        # What the transaction makes has to be shown not to have been there: accounts and slots that are
        # in the state after it and were not in what it read.
        for address, account in change["post"].items():
            touched.setdefault(address.lower(), set()).update((account.get("storage") or {}).keys())
    if emptying:
        return touched, kept, "", ({a: slots for a, slots in written.items() if any(e[0] == a for e in emptied)}, emptied, removed)
    return touched, kept, ""

def system_touches(touched, number, timestamp, at):
    """What the block's own calls read before and after its transactions."""
    ring = 8191
    touched.setdefault(SYSTEM_CONTRACTS["beacon"], set()).update(
        {"0x%064x" % (timestamp % ring), "0x%064x" % (timestamp % ring + ring)})
    touched.setdefault(SYSTEM_CONTRACTS["history"], set()).add("0x%064x" % ((number - 1) % ring))
    for name in ("withdrawals", "consolidations"):
        contract = SYSTEM_CONTRACTS[name]
        try:
            before = rpc("debug_traceCall", [{"from": SYSTEM, "to": contract, "gas": hex(30_000_000)}, at,
                                             {"tracer": "prestateTracer"}])
            slots = set(((before.get(contract) or {}).get("storage") or {}).keys())
        except Exception:
            slots = set()
        touched.setdefault(contract, set()).update(slots | {"0x%064x" % i for i in range(4)})
    touched.setdefault(SYSTEM, set())

# What does not change while the head does not, kept from one round of a slot to the next: what the slot
# fixes, what the block's own calls read, the proofs already fetched (by address: the slots proven and the
# node's answer), and transactions as they go on the wire.
of_head = {"hash": None}
def kept_of(head, ahead=0):
    if of_head["hash"] != head["hash"]:
        of_head.clear()
        of_head.update(hash=head["hash"], proofs={}, raws={}, ahead=ahead)
    elif of_head.get("ahead", 0) != ahead:
        # The same parent for a later slot: what was proven of its state holds, what the slot fixed
        # (withdrawals, the storage the system's calls touch, what a round cost) does not.
        for name in ("slot_inputs", "system", "round"):
            of_head.pop(name, None)
        of_head["ahead"] = ahead
    return of_head

# A slot whose block has not come this many seconds into it is taken to have none, and the slot after it
# is built for on the same parent (only with --rebid and --guest-sends, which is how a feed runs). A block
# that comes later all the same is a new head like any other, and what was built on the old one is no
# use to anybody. Never more than three slots on from the head: further than that it is this machine's
# node that is behind. SHADOW_EMPTY_AFTER says another number, to try it where no slot is empty.
#
# Seven seconds, because this machine's node is late with blocks, an epoch's first above all: such a
# block reaches the beacon node two seconds into its slot like any other, and the execution node is
# told of it more than two seconds after that (measured 2026-11-25). In two days of feeding the builder
# on Compute Engine (5,981 heads) one in 29 was first built on more than four seconds into its slot,
# 181 of those 205 an epoch's first block, of which there were 187; one in 63 more than five seconds,
# one in 127 more than six and one in 374 more than seven. With four seconds the block built on the
# old parent went out while the late one arrived, and a relay that already had it refused the bid:
# five times in two hours on 2026-11-25. A slot that really is empty still leaves time for two or
# three rounds.
EMPTY_AFTER = float(os.environ.get("SHADOW_EMPTY_AFTER", "7"))
def later_block_known(head):
    """Whether the beacon node has a block after `head`'s. A block that comes late is known to it a few
    tenths of a second before the execution node calls it the newest; nothing is built on the old parent
    in between. (The first slot taken for empty on Compute Engine, 15732160, was such a block: the randao
    asked of the beacon node was already the new block's, and two relays refused the bid.)"""
    at = int(get(BEACON, "/eth/v1/beacon/headers/head")["data"]["header"]["message"]["slot"])
    return at > (int(head["timestamp"], 16) - GENESIS_TIME) // 12

def slots_gone(head, now):
    """How many slots after `head`'s have gone by with no block, by the rule above."""
    if not (rebid and guest_sends):
        return 0
    return max(0, int((now - int(head["timestamp"], 16) - EMPTY_AFTER) // 12))

def mend(lacking, nodes, root, proven, at):
    """The trie nodes that a request lacked, given the hash of the first of them the guest missed: found
    in the witness as some node's child, in the trie of accounts or in one account's storage, and asked
    of the node by a hashed key that lies under it, which no proof of any real key had reason to hold."""
    store = {keccak(raw(node)): raw(node) for node in nodes}
    by_hash = {keccak(raw(a)): a for a in proven}
    def split(compact):
        out = [x for b in compact for x in (b >> 4, b & 15)]
        return (out[1:] if out[0] & 1 else out[2:]), bool(out[0] & 2)
    places, seen = [], set()
    todo = [(root, [], None)]
    while todo:
        ref, path, account = todo.pop()
        if ref == lacking:
            places.append((account, path))
        if (ref, account) in seen or ref not in store:
            continue
        seen.add((ref, account))
        items = unrlp(store[ref])[0]
        if len(items) == 17:
            todo += [(child, path + [i], account) for i, child in enumerate(items[:16]) if isinstance(child, bytes) and len(child) == 32]
        elif len(items) == 2:
            rest, leaf = split(items[0])
            if not leaf:
                if isinstance(items[1], bytes) and len(items[1]) == 32:
                    todo.append((items[1], path + rest, account))
            elif account is None:
                whole = bytes(a << 4 | b for a, b in zip((path + rest)[0::2], (path + rest)[1::2]))
                if whole in by_hash:
                    todo.append((unrlp(items[1])[0][2], [], by_hash[whole]))
    found = []
    for account, path in places[:8]:
        padded = path + [0] * (64 - len(path))
        key = "0x" + bytes(a << 4 | b for a, b in zip(padded[0::2], padded[1::2])).hex()
        if account is None:
            state = {"accounts": {key: None}, "storages": {}}
        else:
            about = {"nonce": int(proven[account]["nonce"], 16), "balance": proven[account]["balance"], "bytecode_hash": proven[account]["codeHash"]}
            hashed = "0x" + keccak(raw(account)).hex()
            state = {"accounts": {hashed: about}, "storages": {hashed: {"storage": {key: "0x0"}}}}
        found += rpc("debug_stateWitness", [state, at])
    return found

def build_one(guest, head, log, ahead=0):
    """One round: a block asked of the guest for the slot after `head`'s, or, when `ahead` slots after
    it have gone by with no block, for the one after those, on the same parent."""
    t0 = time.time()
    kept_here = kept_of(head, ahead)
    parent_at = head["number"]      # everything about the state is asked of the parent block, by number
    number = int(head["number"], 16) + 1
    parent_time = int(head["timestamp"], 16)
    timestamp = parent_time + 12 * (1 + ahead)
    slot = (timestamp - GENESIS_TIME) // 12
    record = {"number": number, "slot": slot, "parent": head["hash"], "arrived": round(t0 - (timestamp - 12), 2)}
    if ahead:
        record["after_empty"] = ahead
    if remote and guest.links != guest_keys.get("link", guest.links):
        # A new connection had to be made since the keys were asked for. The same key is the same guest;
        # another is a guest that began again, and what was said of the old one's keys holds no longer.
        key = guest.ask(b"JKEY1")
        guest_keys["link"] = guest.links
        if len(key) == 48 and "0x" + key.hex() != guest_keys.get("builder"):
            guest.boots += 1
            learn_keys(guest)
        record["reconnected"] = guest.links - 1
        record["guest_replaced"] = guest.boots - 1
    if sealed and guest.boots != sealing.get("boot", 1):
        # The guest was replaced: the new one has a key of its own, has been shown no block, and holds
        # nothing that was sealed to the old one.
        sealing.update(boot=guest.boots, key=guest.ask(b"JSEK1"), wire=None, last=0)
        followed["number"], followed["run"] = None, 0
        record["guest_replaced"] = guest.boots - 1

    # What the slot fixes.
    if "slot_inputs" not in kept_here:
        # For the slot after the parent's these are asked of the beacon node's head, which the parent
        # is. For a later slot they are asked of the state at the parent's own slot, by its number, so
        # that a block come late in between changes nothing of what is built on the parent.
        of = str((parent_time - GENESIS_TIME) // 12) if ahead else "head"
        beacon_head = get(BEACON, f"/eth/v1/beacon/headers/{of}")["data"]
        kept_here["slot_inputs"] = (beacon_head["root"],
                                    get(BEACON, f"/eth/v1/beacon/states/{of}/randao")["data"]["randao"],
                                    get(BEACON, f"/eth/v1/builder/states/{of}/expected_withdrawals" +
                                        (f"?proposal_slot={slot}" if ahead else ""))["data"])
    beacon_root, randao, withdrawals = kept_here["slot_inputs"]
    duty, agreeing = proposer(slot)
    record["registered"] = duty is not None
    if live and guest_sends:
        left_alone = [relay for relay in agreeing if relay not in rested(agreeing, time.time())]
        if left_alone:
            record["resting"] = left_alone
            agreeing = [relay for relay in agreeing if relay not in left_alone]
    # With no proposer known the block is built for an address of this program's choosing: the wallet's,
    # or, when a sealed transaction is the wallet's and the wallet is not to be named, nobody's.
    fee_recipient = duty["fee_recipient"] if duty else \
        ("0x000000000000000000000000000000000000dead" if sealed else "0x8aed888c51f20d5d028039674e7e085a108c92dd")
    registered = int(duty["gas_limit"]) if duty else int(head["gasLimit"], 16)
    proposer_key = duty["pubkey"] if duty else "0x" + "00" * 48
    gas_limit = gas_limit_towards(int(head["gasLimit"], 16), registered)

    # The 255 headers before the block, oldest first. They are followed back from the head by parent hash,
    # never asked for by number: when the chain replaces a block, a header kept under its number is one the
    # head no longer descends from, and the guest refuses the lot as no chain. (One replaced block cost 255
    # slots in a row that way, until the stale header left the window.)
    chain, want = [], head["hash"]
    for _ in range(min(255, number)):
        if want not in headers:
            headers[want] = raw(rpc("debug_getRawHeader", [want]))
        chain.append(want)
        want = "0x" + unrlp(headers[want])[0][0].hex()
    chain.reverse()
    for stale in [h for h in headers if h not in set(chain)]:
        del headers[stale]

    # What is proposed, and what it touches.
    base_fee = int(rpc("eth_feeHistory", [1, parent_at, []])["baseFeePerGas"][-1], 16)
    cap = gas_cap or gas_limit
    proposed = candidates(base_fee, 2 * cap, head["hash"])
    record["pending"] = len(proposed)
    # No more of them than this round has time for (see `most_for`). The first round for a head gets
    # half of what is left, when that is three seconds or more; a later one all of it, and never fewer
    # than the round before had with a few more, since a block with less in it pays no more and is not
    # sent.
    before = kept_here.setdefault("proposed", set())
    left = timestamp - ready - FINISHING - time.time()
    halved = "round" not in kept_here and left >= 3
    if "round" in kept_here:
        count, guest_each = kept_here["round"]
        most = most_for(proposed, before, left - 0.05, guest_each, floor=count + 25)
    else:
        most = most_for(proposed, before, left / 2 if halved else left - 0.05)
    if most < len(proposed):
        record["held_to"] = most
        proposed = proposed[:most]
    gathered_new = sum(1 for tx in proposed if tx["hash"] not in before)
    before.update(tx["hash"] for tx in proposed)
    payer, paying = (wallet, int(top_up * 1e18)) if wallet else (None, 0)
    if payer or (presser and duty):
        nonce = int(rpc("eth_getTransactionCount", [(payer or presser).address, parent_at]), 16)
    if presser and duty:
        # Only for a proposer that is known: with none the block's fee recipient is this program's choice.
        press = press_for(presses(button_path), presser.address, nonce, slot, int(time.time()))
        if press:
            payer, paying = presser, press["wei"]
            record["press"] = press["at"]
    if payer:
        proposed = [payer.pay(nonce, base_fee, paying, number, fee_recipient, top_up_priority)] + \
                   [tx for tx in proposed if tx["from"].lower() != payer.address]
        record["top_up_eth"] = paying / 1e18
        # By this a block of this slot is known for ours when it is in the chain, even one that this
        # program was not shown: the payment is good in no other block.
        record["payment_hash"] = proposed[0]["hash"]
    override = {"number": hex(number), "time": hex(timestamp), "gasLimit": hex(gas_limit),
                "feeRecipient": fee_recipient, "prevRandao": randao, "baseFeePerGas": hex(base_fee)}
    # Transactions that empty a slot are proposed when the node can say what the trie needs for it, and
    # not for the rest of a head on which the guest once found the witness short.
    emptying = has_state_witness() and not kept_here.get("no_emptying")
    written, emptied, removed = {}, set(), set()
    if emptying:
        touched, kept, why, *more = touched_by(proposed, override, parent_at, True)
        if more:
            written, emptied, removed = more[0]
    else:
        touched, kept, why = touched_by(proposed, override, parent_at)
    if touched is None:
        record["skipped"] = "trace: " + why
        return record
    if left_slow["count"]:
        record["slow_left_out"] = left_slow["count"]
    record["proposed"] = len(kept)
    if "system" not in kept_here:
        kept_here["system"] = {}
        system_touches(kept_here["system"], number, timestamp, parent_at)
    for address, slots in kept_here["system"].items():
        touched.setdefault(address, set()).update(slots)
    # What the guest has said it lacked, for transactions this program was not shown: proven as well.
    for address, slots in wanted_more.items():
        touched.setdefault(address, set()).update(slots)
    if with_proofs:
        # The guest has been checking the block that has just arrived all this while (see `main`); what
        # follows needs it to have finished.
        following["thread"].join()
        took, why = following["result"]
        record["followed"] = took if took else why
        if not took:
            # The guest has lost its place in the chain, and with it what it kept: handed in again.
            sealing.update(last=0, held=False)
        if followed["seconds"]:
            record["follow_seconds"] = followed["seconds"][-1]
    if with_proofs and (sealing["wire"] is None or sealing["last"] < slot):
        # As the sender: a call that reads a contract's code and a slot of its storage, with proofs of
        # all it reads at the newest block, sealed together and handed in. The host is told nothing.
        nonce = int(rpc("eth_getTransactionCount", [sender.address, parent_at]), 16) + after_payment
        wire, marks = sender.wrap_nothing(nonce, base_fee)
        # What it reads is asked of a node, as any sender would ask (scripts/seal-with-proofs): the node
        # must find the wallet's slot in the contract for itself. Every other time the proofs are taken
        # at the block before the newest, which the guest has also checked and must bring them on from.
        balance_slot = "0x" + keccak(bytes(12) + raw(sender.address) + (3).to_bytes(32, "big")).hex()
        ask_node = sender_tool.rpc_at(RPC)
        back = 1 if followed.get("run", 0) >= 2 and sealing.get("handed", 0) % 2 == 1 else 0
        anchor = rpc("eth_getBlockByNumber", [hex(number - 1 - back), False])
        accounts = sender_tool.touched(ask_node, wire, sender.address, anchor["number"])
        if os.environ.get("SHADOW_PROOFS_SHORT"):
            # To try a sender whose proofs fall short: the slot is left out.
            accounts[WETH] = []
        proof_nodes, proof_codes = sender_tool.proofs(ask_node, accounts, anchor["number"])
        envelope = sender_tool.seal(sealing["key"], slot + 3, wire, anchor["hash"], accounts, proof_nodes, proof_codes)
        sealing.update(wire=wire, last=slot + 3, marks=sealing["marks"] + [wire] + marks, handed=sealing.get("handed", 0) + 1,
                       about=[raw(sender.address), raw(balance_slot), keccak(raw(sender.address)), keccak(raw(balance_slot))])
        record["proofs_at"] = "the block before the newest" if back else "the newest block"
        record["proofs_name_the_slot"] = balance_slot in accounts.get(WETH, [])
        if sealing["handed"] == 2:
            # Once, things that must be refused: proofs with a node taken out, and proofs said to be at
            # a block the guest has never been shown.
            short = sender_tool.seal(sealing["key"], slot + 3, wire, anchor["hash"], accounts, proof_nodes[1:], proof_codes)
            unknown = sender_tool.seal(sealing["key"], slot + 3, wire, "0x" + os.urandom(32).hex(), accounts, proof_nodes, proof_codes)
            record["refused"] = [guest.ask(b"JSEA2" + short)[:1].hex(), guest.ask(b"JSEA2" + unknown)[:1].hex()]
        record["sealed_handed_in"] = guest.ask(b"JSEA2" + envelope)[:1].hex()
        sealing["held"] = record["sealed_handed_in"] == "00"
        record["sealed_bytes"] = len(envelope)
        record["proof_nodes"] = len(proof_nodes)
    elif sealed and (sealing["wire"] is None or sealing["last"] < slot):
        # As the sender: a transaction signed, sealed to the guest for this slot and the three after, and
        # handed in. From here on this program, as the host, has only the sealed bytes.
        # After the payment, when there is one: both are the wallet's, and the payment goes first.
        nonce = int(rpc("eth_getTransactionCount", [sender.address, parent_at]), 16) + after_payment
        wire, marks = sender.to_itself(nonce, base_fee)
        envelope = seal_for_guest(slot + 3, wire)
        # Every sealed transaction of the run is looked for at the end, not only the last.
        sealing.update(wire=wire, last=slot + 3, marks=sealing["marks"] + [wire] + marks)
        record["sealed_handed_in"] = guest.ask(b"JSEA1" + envelope)[:1].hex()
        record["sealed_bytes"] = len(envelope)
    for address in [fee_recipient] + [w["address"] for w in withdrawals] + [tx["from"] for tx in kept] + \
                   [tx["to"] for tx in kept if tx.get("to")]:
        touched.setdefault(address.lower(), set())
    t1 = time.time()

    # Proofs and code at the head, and the transactions as they go on the wire.
    # The node proves at most PROOF_KEYS slots of one account in a call, so an account with more is asked
    # for in pieces: the account's own proof is the same in each, and the slots' proofs are joined.
    addresses = sorted(touched)
    # Only what was not proven in an earlier round for this head is asked for: an account not yet seen,
    # or one with slots that were not among those proven.
    had = kept_here["proofs"]
    fresh = [a for a in addresses if a not in had or not touched[a] <= had[a][0]]
    # Of an account proven before, only the slots that are new are asked for: the account's own proof is
    # the same, and a contract many transactions use would otherwise be proven whole every round.
    asked_for = {a: sorted(touched[a] - had[a][0]) if a in had else sorted(touched[a]) for a in fresh}
    pieces = [(a, slots[i:i + PROOF_KEYS]) for a in fresh for slots in [asked_for[a]]
              for i in range(0, max(len(slots), 1), PROOF_KEYS)]
    answers = batch([("eth_getProof", [a, slots, parent_at]) for a, slots in pieces], workers=32, size=5)
    record["proofs_asked"] = len(fresh)
    joined = {}
    for (a, slots), answer in zip(pieces, answers):
        if answer is None:       # asked once more, alone
            try:
                answer = rpc("eth_getProof", [a, slots, parent_at])
            except RuntimeError as error:
                record["skipped"] = f"no proof of {a} with {len(touched[a])} slots at the parent: {error}"[:300]
                return record
        if a in joined:
            joined[a]["storageProof"] += answer["storageProof"]
        else:
            joined[a] = answer
    for a in fresh:
        if a in had:
            had[a][1]["storageProof"] += joined[a]["storageProof"]
            had[a][0].update(asked_for[a])
        else:
            had[a] = (set(touched[a]), joined[a])
    for a in addresses:
        touched[a] = had[a][0]
    proofs = [had[a][1] for a in addresses]
    # A transaction the pool has let go of since it was listed is not proposed.
    unknown = [tx["hash"] for tx in kept if "wire" not in tx and tx["hash"] not in kept_here["raws"]]
    kept_here["raws"].update(zip(unknown, batch([("eth_getRawTransactionByHash", [h]) for h in unknown])))
    raws = [kept_here["raws"][tx["hash"]] for tx in kept if "wire" not in tx]
    raws = ["0x" + tx["wire"].hex() for tx in kept if "wire" in tx] + raws
    kept = [tx for tx in kept if "wire" in tx] + [tx for tx in kept if "wire" not in tx]
    kept = [tx for tx, r in zip(kept, raws) if r]
    raws = [r for r in raws if r]
    record["proposed"] = len(kept)
    # A block's worth is what the proposer's fee recipient holds after it over what it held before
    # (Evm.Build), so a transaction that account sends itself makes the bid too low, or none. Such a
    # transaction is proposed like any other; the record says whose the fees are and how many were its own.
    record["fee_recipient"] = fee_recipient
    own = sum(1 for tx in kept if (tx.get("from") or "").lower() == fee_recipient.lower())
    if own:
        record["from_fee_recipient"] = own
    new_code = [a for a, p in zip(addresses, proofs) if p["codeHash"] not in codes]
    for a, code in zip(new_code, batch([("eth_getCode", [a, parent_at]) for a in new_code])):
        codes[dict(zip(addresses, proofs))[a]["codeHash"]] = raw(code or "0x")
    nodes = set()
    for proof in proofs:
        nodes.update(proof["accountProof"])
        for storage in proof["storageProof"]:
            nodes.update(storage["proof"])
    if emptied:
        # What the trie needs beyond the way to each slot: where emptying one leaves a branch with a
        # single child, that child, which no proof of the slot holds. Asked of the node for each
        # emptied slot alone, in case only its transaction goes in, and for all those of an account
        # together, as the block will have them if every transaction does. (For some of them and not
        # others nothing is asked: the guest then finds the witness short, and emptying is given up
        # for the head.)
        hashed = lambda item: "0x" + keccak(raw(item)).hex()
        about = lambda a: {"nonce": int(had[a][1]["nonce"], 16), "balance": had[a][1]["balance"], "bytecode_hash": had[a][1]["codeHash"]}
        state_of = lambda writes: {"accounts": {hashed(a): about(a) for a in writes},
                                   "storages": {hashed(a): {"storage": {hashed(slot): value for slot, value in slots.items()}}
                                                for a, slots in writes.items()}}
        # Asked once a head for each thing: the node takes some 30 ms a slot, one call after another.
        known = kept_here.setdefault("emptied", {})
        together = {}
        for a, one in emptied:
            together.setdefault(a, set()).add(one)
        wanted_now = [(a, frozenset({one})) for a, one in sorted(emptied)] + \
                     [(a, frozenset(several)) for a, several in sorted(together.items()) if len(several) > 1]
        asks = [ask for ask in wanted_now if ask not in known and ask[0] in had]
        answers = batch([("debug_stateWitness", [state_of({a: {one: "0x0" for one in several}}), parent_at]) for a, several in asks],
                        workers=16, size=1)
        for ask, answer in zip(asks, answers):
            if answer is not None:
                known[ask] = answer
        for ask in wanted_now:
            nodes.update(known.get(ask) or [])
        record["emptying_asked"] = len(asks)
        record["emptying"] = len(emptied)
    if removed:
        # The same for an account that is taken out of the state: the trie of accounts can fold up there.
        known = kept_here.setdefault("removed", {})
        asks = [a for a in sorted(removed) if a not in known]
        answers = batch([("debug_stateWitness", [{"accounts": {"0x" + keccak(raw(a)).hex(): None}, "storages": {}}, parent_at]) for a in asks],
                        workers=16, size=1)
        for a, answer in zip(asks, answers):
            if answer is not None:
                known[a] = answer
        for a in removed:
            nodes.update(known.get(a) or [])
        record["removing"] = len(removed)
    # And whatever the guest has found short on this head, mended after the fact (below).
    nodes.update(kept_here.get("mended", ()))
    keys = [raw(a) for a in addresses] + [raw(s) for a in addresses for s in sorted(touched[a])]
    t2 = time.time()

    # The request.
    def tx_item(data):
        return unrlp(data)[0] if data[0] >= 0xc0 else data
    template_header = [raw(head["hash"]), EMPTY_OMMERS, raw(fee_recipient), bytes(32), bytes(32), bytes(32),
                       bytes(256), 0, number, gas_limit, 0, timestamp, b"cluck", raw(randao), bytes(8),
                       0, bytes(32), 0, 0, raw(beacon_root), bytes(32)]
    wire = [raw(r) for r in raws]
    block = rlp([template_header, [tx_item(w) for w in wire], [],
                 [[int(w["index"]), int(w["validator_index"]), raw(w["address"]), int(w["amount"])]
                  for w in withdrawals]])
    sized = lambda data: struct.pack(">I", len(data)) + data
    listed = lambda items: struct.pack(">I", len(items)) + b"".join(sized(i) for i in items)
    code_list = sorted({codes[p["codeHash"]] for p in proofs if codes.get(p["codeHash"])})
    makings = (bytes([255]) + struct.pack(">Q", 1) + bytes([1]) + struct.pack(">Q", cap) +
               sized(block) + listed([headers[h] for h in chain]) + listed([raw(n) for n in sorted(nodes)]) +
               listed(code_list) + listed(keys))
    # Asked for as a bid: the guest signs what it builds with its own key, for this slot and proposer.
    # It is told how long it may go on adding transactions: until `ready` seconds before the slot, less what
    # ending the block, signing and the way back have been seen to take. Out of time it ends the block with
    # what is in it, so a slow block is a smaller one, not a late one. (0 means no limit, which is what
    # comparing the two builders is done with: then an answer depends on the request alone.)
    allowed = 0 if engine == "both" else max(1, int((timestamp - ready - FINISHING - time.time()) * 1000))
    if allowed and halved:
        # The first round for a head is to be over when half the time was: the guest is told so too, with
        # a third over, in case the transactions are slower than the last rounds' were. Never less than
        # half of what it would have had.
        allowed = max(allowed // 2, min(allowed, int((t0 + (left / 2) * 1.3 - time.time()) * 1000)))
    record["allowed_ms"] = allowed
    def bid_for(name):
        return (b"JBID2" + struct.pack(">Q", slot) + raw(proposer_key) + bytes(4) +
                struct.pack(">I", min(allowed, 2**32 - 1)) + name + makings)
    request = bid_for(b"JBLF1" if engine == "fast" else b"JBLD1")
    record["engine"] = engine
    record["request_bytes"] = len(request)
    # Asked for with a report (Evm/Attest.lean): the challenge is the parent's hash, which nobody had
    # before the parent existed, so a quote made from the report says the answer is no older than that.
    challenge = raw(head["hash"])
    if ahead and later_block_known(head):
        # The block of the slot taken for empty came while this round was gathered. Nothing is asked of
        # the guest: it would send a block on a parent the relays no longer build on.
        record["skipped"] = "the slot taken for empty has a block after all"
        return record
    relay_said = None
    if guest_sends:
        # The guest builds, bids, and posts the block itself (Evm/Send.lean), certificates judged at this
        # machine's time, three seconds for an answer. To the stand-in, the one relay of the shadow
        # image's list; or, live, to those of the relays named that hold the registration the block is
        # built for, and to none when none does.
        where = sum(1 << place_of(relay) for relay in agreeing) if live else 1
        if hold:
            where = 0
        if time.time() > timestamp - ready:
            # Too late for this slot: built, for the record, and sent nowhere. (The first live run sent
            # such a block, an empty one, and three relays said what it was: for a slot gone by.)
            where = 0
            record["too_late"] = True
        if with_proofs:
            # A block is worth sending when the sealed transaction can be in it: the guest took the
            # newest block, holds a transaction it accepted, and has time to reach it after the
            # public ones. Otherwise a payment could win a slot for a block without it.
            record["sealed_can_be_in"] = bool(following["result"][0] and sealing.get("held") and allowed >= 500)
            if live and not record["sealed_can_be_in"]:
                where = 0
        record["sent_to"] = [relay for relay in agreeing if where] if live else ["the stand-in"]
        reply = guest.ask(b"JSND1" + bytes([where]) + struct.pack(">QI", int(time.time()), relay_wait) + request)
        if len(reply) >= 4:
            size = struct.unpack(">I", reply[:4])[0]
            reply, rest = reply[4:4 + size], reply[4 + size:]
            relay_said, at = [], 1
            for _ in range(rest[0] if rest else 0):
                failed, status, length = rest[at + 1], *struct.unpack(">HH", rest[at + 2:at + 6])
                relay_said.append(["no answer" if failed else status, rest[at + 6:at + 6 + length].decode(errors="replace")])
                if live and not failed:
                    heard(rest[at], status, time.time())
                at += 6 + length
            # What the witness lacked for transactions left out: remembered, to be proven next time.
            lacked = rest[at] if len(rest) > at else 0
            for i in range(lacked):
                kind, what, key = rest[at + 1 + 65 * i], rest[at + 2 + 65 * i:at + 34 + 65 * i], rest[at + 34 + 65 * i:at + 66 + 65 * i]
                if kind in (0, 1):
                    wanted_more.setdefault("0x" + what[12:].hex(), set()).update({"0x" + key.hex()} if kind == 1 else set())
            record["lacked"] = lacked
    else:
        reply = guest.ask(b"JATT1" + challenge + request if attest else request)
    t3 = time.time()
    if t3 - t2 > 2:
        # Kept whole, to find out what was slow.
        kept_dir = os.path.join(os.path.dirname(log_path), "slow")
        os.makedirs(kept_dir, exist_ok=True)
        with open(os.path.join(kept_dir, f"{number}.req"), "wb") as f:
            f.write(request)
    record["seconds"] = {"inputs_and_trace": round(t1 - t0, 2), "proofs": round(t2 - t1, 2),
                         "guest": round(t3 - t2, 2), "total": round(t3 - t0, 2)}
    learn_pace(gathered_new, len(kept), t2 - t0, t3 - t2)
    if len(kept) >= 20:
        kept_here["round"] = (len(kept), max(0.0005, (t3 - t2 - FIXED) / len(kept)))
    record["ready_before_slot"] = round(timestamp - t3, 2)
    if reply[:1] == b"\x08":
        # A block that sealed transactions were tried in, which this program is not shown, nor told
        # whether they went in. What follows is the
        # relay's side: what the stand-in took for this slot, read from where it wrote it down, and judged
        # by the node as a relay would have it judged.
        record.update({"status": 0, "sealed_tried": True, "relay": relay_said})
        if relay_said == []:
            # The guest kept it: it paid no more than one a relay already has for the slot.
            record["not_sent"] = True
            return record
        if live:
            # Sent to real relays, and this program has nothing of it but what they said.
            return record
        took = None
        for name in sorted(os.listdir(standin_dir), key=lambda n: os.path.getmtime(os.path.join(standin_dir, n))):
            if name.endswith(".json"):
                with open(os.path.join(standin_dir, name)) as f:
                    found = json.load(f)
                if found["message"]["slot"] == str(slot) and found["message"]["parent_hash"] == head["hash"]:
                    took = found
        if took is None:
            record["judged"] = "nothing arrived at the relay"
            return record
        record.update({"hash": took["message"]["block_hash"], "went_in": len(took["execution_payload"]["transactions"]),
                       "gas_used": int(took["message"]["gas_used"]), "value_eth": int(took["message"]["value"]) / 1e18,
                       "sealed_landed": "0x" + sealing["wire"].hex() in took["execution_payload"]["transactions"]})
        try:
            rpc("flashbots_validateBuilderSubmissionV5", [dict(took, registered_gas_limit=str(registered),
                                                               parent_beacon_block_root=beacon_root)])
            record["judged"] = "valid"
        except RuntimeError as error:
            record["judged"] = str(error)[:300]
        # The bid's signature, checked as a relay checks it: from the bytes that were posted.
        record["signed"] = subprocess.run([bid_verify, "--submission",
                                           os.path.join(standin_dir, record["hash"] + ".ssz")], capture_output=True).returncode == 0
        # The stand-in's copies hold a signed transaction of the wallet's: thrown away once looked at.
        for ending in (".ssz", ".json"):
            os.remove(os.path.join(standin_dir, record["hash"] + ending))
        return record
    if not reply or reply[0] != 0:
        if reply and reply[0] == 6 and len(reply) >= 33 and has_state_witness():
            # The witness fell short. The guest says which node it wanted, by its hash; where that node
            # hangs is found by walking the witness from the root, and the node is then asked for by a
            # key made up to lie under that place. It goes into every later request on this head.
            try:
                found = mend(reply[1:33], nodes, raw(head["stateRoot"]), {a: had[a][1] for a in addresses}, parent_at)
            except Exception as error:
                found = []
                record["mend_failed"] = f"{type(error).__name__}: {error}"[:200]
            kept_here.setdefault("mended", set()).update(found)
            record["mended"] = len(found)
            if not found and emptied:
                kept_here["no_emptying"] = True
                record["emptying_given_up"] = True
        record["status"] = reply[0] if reply else -1
        record["lacking"] = reply[1:33].hex() if len(reply) >= 33 else ""
        # Kept whole, for `build-why`.
        kept_dir = os.path.join(os.path.dirname(log_path), "unbuilt")
        os.makedirs(kept_dir, exist_ok=True)
        with open(os.path.join(kept_dir, f"{number}.req"), "wb") as f:
            f.write(request)
        return record

    # What was built, as a bid.
    block_hash, state_root = reply[1:33], reply[33:65]
    value = int.from_bytes(reply[65:97], "big")
    gas_used = struct.unpack(">Q", reply[97:105])[0]
    count = struct.unpack(">I", reply[105:109])[0]
    places = struct.unpack(f">{count}I", reply[109:109 + 4 * count])
    at = 109 + 4 * count
    header_size = struct.unpack(">I", reply[at:at + 4])[0]
    header, _ = unrlp(reply[at + 4:at + 4 + header_size])
    at += 4 + header_size
    made = []
    for _ in range(struct.unpack(">I", reply[at:at + 4])[0]):
        n = struct.unpack(">I", reply[at + 4:at + 8])[0]
        made.append(reply[at + 8:at + 8 + n])
        at += 4 + n
    at += 4
    # What follows the signature is the report, when one was asked for and made.
    report, reply = reply[at + 144:], reply[:at + 144]
    number_of = lambda item: str(int.from_bytes(item, "big"))
    hexed = lambda item: "0x" + item.hex()
    payload = {
        "parent_hash": hexed(header[0]), "fee_recipient": hexed(header[2]), "state_root": hexed(header[3]),
        "receipts_root": hexed(header[5]), "logs_bloom": hexed(header[6]), "prev_randao": hexed(header[13]),
        "block_number": number_of(header[8]), "gas_limit": number_of(header[9]), "gas_used": number_of(header[10]),
        "timestamp": number_of(header[11]), "extra_data": hexed(header[12]), "base_fee_per_gas": number_of(header[15]),
        "block_hash": hexed(block_hash), "transactions": [hexed(wire[i]) for i in places],
        "withdrawals": [{"index": w["index"], "validator_index": w["validator_index"], "address": w["address"],
                         "amount": w["amount"]} for w in withdrawals],
        "blob_gas_used": number_of(header[17]), "excess_blob_gas": number_of(header[18])}
    requests = {"deposits": [], "withdrawals": [], "consolidations": []}
    little = lambda data: str(int.from_bytes(data, "little"))
    for item in made:
        kind, data = item[0], item[1:]
        if kind == 0:
            for i in range(0, len(data), 192):
                d = data[i:i + 192]
                requests["deposits"].append({"pubkey": hexed(d[:48]), "withdrawal_credentials": hexed(d[48:80]),
                    "amount": little(d[80:88]), "signature": hexed(d[88:184]), "index": little(d[184:192])})
        elif kind == 1:
            for i in range(0, len(data), 76):
                d = data[i:i + 76]
                requests["withdrawals"].append({"source_address": hexed(d[:20]), "validator_pubkey": hexed(d[20:68]),
                    "amount": little(d[68:76])})
        elif kind == 2:
            for i in range(0, len(data), 116):
                d = data[i:i + 116]
                requests["consolidations"].append({"source_address": hexed(d[:20]), "source_pubkey": hexed(d[20:68]),
                    "target_pubkey": hexed(d[68:116])})
    submission = {
        "message": {"slot": str(slot), "parent_hash": head["hash"], "block_hash": hexed(block_hash),
                    "builder_pubkey": hexed(reply[at:at + 48]), "proposer_pubkey": proposer_key,
                    "proposer_fee_recipient": fee_recipient, "gas_limit": str(gas_limit), "gas_used": str(gas_used),
                    "value": str(value)},
        "execution_payload": payload,
        "blobs_bundle": {"commitments": [], "proofs": [], "blobs": []},
        "execution_requests": requests,
        "signature": hexed(reply[at + 48:at + 144]),
        "registered_gas_limit": str(registered),
        "parent_beacon_block_root": beacon_root}
    record["txs"] = [kept[i]["hash"] for i in places]
    record.update({"status": 0, "hash": hexed(block_hash), "went_in": count, "gas_used": gas_used,
                   "value_eth": value / 1e18, "randao": randao,
                   "withdrawals": [w["index"] for w in withdrawals]})
    if guest_sends:
        record["relay"] = relay_said
        if relay_said == [] and (where or record.get("too_late")):
            # The guest kept it: it paid no more than one a relay already has for the slot.
            record["not_sent"] = True
    if guest_sends and not live and not record.get("not_sent"):
        # What the stand-in relay made of what the guest posted, beside what is made of the answer here:
        # the same request, field for field, or not.
        lowered = lambda x: ({k: lowered(v) for k, v in x.items()} if isinstance(x, dict) else
                             [lowered(v) for v in x] if isinstance(x, list) else x.lower())
        mine = lowered({k: v for k, v in submission.items() if k not in ("registered_gas_limit", "parent_beacon_block_root")})
        try:
            with open(os.path.join(standin_dir, hexed(block_hash) + ".json")) as f:
                theirs = lowered(json.load(f))
            record["relay_same"] = theirs == mine
            if theirs != mine:
                record["relay_differs"] = sorted(k for k in mine if theirs.get(k) != mine[k])
        except OSError:
            record["relay_same"] = False
            record["relay_differs"] = ["nothing arrived"]
    record["builder"] = hexed(reply[at:at + 48])
    def check():
        try:
            look()
        except Exception as error:
            # The node did not answer, say: the block stands in the record as one nobody judged.
            record["unchecked"] = f"{type(error).__name__}: {error}"[:200]
            raise
    def look():
        began = time.time()
        try:
            rpc("flashbots_validateBuilderSubmissionV5", [submission])
            record["judged"] = "valid"
        except RuntimeError as error:
            record["judged"] = str(error)[:300]
            # Kept whole for whoever looks into it: the request, the reply and what the node said.
            kept_dir = os.path.join(os.path.dirname(log_path), "refused")
            os.makedirs(kept_dir, exist_ok=True)
            with open(os.path.join(kept_dir, f"{number}.req"), "wb") as f:
                f.write(request)
            with open(os.path.join(kept_dir, f"{number}.reply"), "wb") as f:
                f.write(reply)
            with open(os.path.join(kept_dir, f"{number}.json"), "w") as f:
                json.dump({"submission": submission, "said": str(error),
                           "transactions": [kept[i]["hash"] for i in places]}, f)
        record["seconds"]["judge"] = round(time.time() - began, 2)
        # The signature, checked from outside with the reference's verification.
        with open(log_path + ".last.req", "wb") as f:
            f.write(request)
        with open(log_path + ".last.reply", "wb") as f:
            f.write(reply)
        checked = subprocess.run([bid_verify, log_path + ".last.req",
                                  log_path + ".last.reply"], capture_output=True, text=True)
        record["signed"] = checked.returncode == 0
        with open(log_path + ".last.json", "w") as f:
            json.dump({"slot": slot, "number": number, "hash": hexed(block_hash), "challenge": hexed(challenge),
                       "report": report.hex(), "submission": submission}, f)
    if rebid and guest_sends and engine != "both":
        checks.put(check)
        return record
    check()
    # Sent to relays only when asked to be, and then only a block the node's validator judged valid, with
    # a signature that verifies, in time, to relays that hold this registration for the slot. A relay is
    # sent the bid as the builder API has it: the two fields the validator wanted besides are left off.
    if live and not guest_sends:
        usable = record.get("judged") == "valid" and record["signed"] and time.time() < timestamp + 1
        if not usable or not agreeing:
            record["sent"] = "not sent: " + ("no relay holds this registration" if usable else "not valid, signed and in time")
        else:
            bid = {k: v for k, v in submission.items() if k not in ("registered_gas_limit", "parent_beacon_block_root")}
            body = json.dumps(bid).encode()
            with ThreadPoolExecutor(len(agreeing)) as pool:
                said = list(pool.map(lambda relay: submit(relay, body, timestamp + 1), agreeing))
            record["sent"] = dict(zip(agreeing, said))
            record["sent_before_slot"] = round(timestamp - time.time(), 2)
    if engine == "both":
        # The same request to the fast engine's builder, after everything about the first answer is done.
        # The two answers must be the same bytes: the same block, and so the same signature over it.
        t4 = time.time()
        again = guest.ask(bid_for(b"JBLF1"))
        record["fast_seconds"] = round(time.time() - t4, 2)
        record["fast_same"] = len(again) > 0 and again == reply
        if not record["fast_same"]:
            kept_dir = os.path.join(os.path.dirname(log_path), "differ")
            os.makedirs(kept_dir, exist_ok=True)
            with open(os.path.join(kept_dir, f"{number}.req"), "wb") as f:
                f.write(request)
            with open(os.path.join(kept_dir, f"{number}.jaune.reply"), "wb") as f:
                f.write(reply)
            with open(os.path.join(kept_dir, f"{number}.fast.reply"), "wb") as f:
                f.write(again)
    return record

def keep(record, where, on_chain):
    """What shows that a block was built here, kept together under `where`: the request, the reply, and a
    file that says which block it is, with the challenge, the report, and which image and source the
    operator says were running; and beside them the quote this host's quoting service makes of the
    report. demo/built.html checks them in a browser, and demo/test-built.mjs under node."""
    kept_dir = os.path.join(os.path.dirname(log_path), where)
    os.makedirs(kept_dir, exist_ok=True)
    stem = os.path.join(kept_dir, str(record["number"]))
    with open(log_path + ".last.json") as f:
        about = json.load(f)
    if about["hash"] != record.get("hash"):
        return
    for ending in ("req", "reply"):
        shutil.copyfile(f"{log_path}.last.{ending}", f"{stem}.{ending}")
    report = bytes.fromhex(about["report"])
    if len(report) == 1024:
        try:
            import importlib.machinery, importlib.util
            sys.dont_write_bytecode = True
            loader = importlib.machinery.SourceFileLoader("tdx_quote", os.path.join(system, "scripts/tdx-quote"))
            module = importlib.util.module_from_spec(importlib.util.spec_from_loader("tdx_quote", loader))
            loader.exec_module(module)
            with open(stem + ".quote", "wb") as f:
                f.write(module.get_quote(QGS, report))
            record["quote"] = stem + ".quote"
        except Exception as error:
            record["quote"] = f"none: {type(error).__name__}: {error}"[:200]
    about.update(identity, landed=on_chain, sent=record.get("sent"), delivered=record.get("delivered"))
    with open(stem + ".json", "w") as f:
        json.dump(about, f)

def landed(record, head):
    """A block built here is the chain's head: what each relay says it delivered, and the lot kept."""
    delivered = {}
    for relay in RELAYS:
        try:
            rows = get(relay, f"/relay/v1/data/bidtraces/proposer_payload_delivered?slot={record['slot']}")
            delivered[relay] = [row.get("block_hash") == head["hash"] for row in rows]
        except Exception as error:
            delivered[relay] = str(error)[:100]
    record["delivered"] = delivered
    if sealed:
        # The block is public now, and anyone may look: whether a sealed transaction of this run is in it.
        record["sealed_landed"] = any("0x" + keccak(mark).hex() in head.get("transactions", [])
                                      for mark in sealing["marks"] if len(mark) > 32)
    if guest_sends:
        # A block the guest sent: there is no answer with a report to keep. What ties it to the machine is
        # that the relay names the builder's key, and that key came with a report when the run began.
        kept_dir = os.path.join(os.path.dirname(log_path), "landed")
        os.makedirs(kept_dir, exist_ok=True)
        with open(os.path.join(kept_dir, f"{record['number']}.sent.json"), "w") as f:
            json.dump(dict(record, **identity, keys=guest_keys), f)
        return
    keep(record, "landed", True)

def quoted_before(guest):
    """What an earlier run kept of the keys of a guest somewhere else, quotes and all, when the guest
    still has those keys: the newest such record beside this run's log, or nothing.

    A guest draws its keys when it starts, so the same two keys are the same start of the same guest,
    and a quote that says a machine with these measurements holds them says so for as long as it runs.
    Asking again each hour adds nothing to that, and each asking is a request the guest's host must
    serve, which on Google's machines has ended some guests (TODO.md)."""
    import glob
    builder, sealing = guest.ask(b"JKEY1"), guest.ask(b"JSEK1")
    if len(builder) != 48 or len(sealing) != 32:
        return None
    quoted = lambda q: isinstance(q, str) and len(q) >= 2000 and all(c in "0123456789abcdef" for c in q)
    records = glob.glob(os.path.join(os.path.dirname(log_path), "*.keys.json")) + \
              glob.glob(os.path.join(os.path.dirname(log_path), "*.keys.*.json"))
    for path in sorted(records, key=os.path.getmtime, reverse=True):
        try:
            with open(path) as f:
                kept = json.load(f)
        except (OSError, ValueError):
            continue
        if kept.get("builder") == "0x" + builder.hex() and kept.get("sealing") == "0x" + sealing.hex() \
                and quoted(kept.get("builder_quote")) and quoted(kept.get("sealing_quote")):
            return dict(kept, quoted_in=kept.get("quoted_in") or os.path.basename(path))
    return None

def learn_keys(guest):
    """The guest's two keys, each asked for with a report, the challenge the chain's newest block: the
    builder's, which a relay will name as the builder of any block the guest sends, and the one
    transactions are sealed to. The quotes made of the reports are kept beside the log; a guest somewhere
    else is asked to get them from its own host, once for each time it starts (`quoted_before`)."""
    kept = quoted_before(guest) if remote else None
    if kept:
        guest_keys.clear()
        guest_keys.update(kept, boot=guest.boots, link=guest.links)
        with open(log_path + ".keys.json" if guest.boots <= 1 else f"{log_path}.keys.{guest.boots}.json", "w") as f:
            json.dump(guest_keys, f)
        return
    guest_keys.pop("quoted_in", None)
    try:
        import importlib.machinery, importlib.util
        sys.dont_write_bytecode = True
        loader = importlib.machinery.SourceFileLoader("tdx_quote", os.path.join(system, "scripts/tdx-quote"))
        quoting = importlib.util.module_from_spec(importlib.util.spec_from_loader("tdx_quote", loader))
        loader.exec_module(quoting)
    except Exception:
        quoting = None
    # A guest somewhere else that began again while it was being asked has answered partly as one
    # start and partly as the next, with a key of each: the connection was lost between, which shows,
    # and then all of it is asked again.
    for again in range(3):
        links = guest.links
        challenge = raw(rpc("eth_getBlockByNumber", ["latest", False])["hash"])
        guest_keys.update(challenge="0x" + challenge.hex(), boot=guest.boots)
        for name, asked, size in (("builder", b"JKEY1", 48), ("sealing", b"JSEK1", 32)):
            answer = guest.ask(b"JATT1" + challenge + asked)
            guest_keys[name] = "0x" + answer[:size].hex()
            if remote:
                # No quoting service of this machine's can vouch for another machine's report: the guest
                # is asked to have its own host make the quote (Evm/Attest.lean, "JQUO1").
                report = answer[size:] if len(answer) == size + 1024 else b""
                guest_keys[name + "_report"] = report.hex() or None
                made = guest.ask(b"JQUO1" + report) if report else b""
                guest_keys[name + "_quote"] = made[1:].hex() if made[:1] == b"\0" else f"none: {made[1:200].decode(errors='replace')}"
                continue
            try:
                guest_keys[name + "_quote"] = quoting.get_quote(QGS, answer[size:]).hex() if len(answer) == size + 1024 else None
            except Exception as error:
                guest_keys[name + "_quote"] = f"none: {type(error).__name__}: {error}"[:200]
        if not remote or links == 0 or guest.links == links:
            break
        guest_keys["asked_again"] = again + 1
    guest_keys["link"] = guest.links
    with open(log_path + ".keys.json" if guest.boots <= 1 else f"{log_path}.keys.{guest.boots}.json", "w") as f:
        json.dump(guest_keys, f)

def main():
    # Stopped from outside, the guest it started is stopped with it.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    if guest_sends and not live:
        # The stand-in relay, for the guest to post to: ended with this program.
        global standin_dir
        standin_dir = log_path + ".relay"
        relay = subprocess.Popen([os.path.join(here, "builder/standin-relay"), "--out", standin_dir],
                                 stdout=subprocess.PIPE, text=True)
        import atexit
        atexit.register(relay.kill)
        if "listening" not in relay.stdout.readline():
            sys.exit("shadow: the stand-in relay did not start")
    guest = Guest()
    if guest_sends or remote:
        learn_keys(guest)
        if remote and len(raw(guest_keys["builder"])) != 48:
            sys.exit(f"shadow: no guest answered at {remote}")
    if sealed:
        sealing["key"] = raw(guest_keys["sealing"])
        if len(sealing["key"]) != 32:
            sys.exit("shadow: the guest gave no sealing key")
    log = open(log_path, "a")
    # Which image and source this is, as far as this program can say: the image file it booted, and the
    # commit the working tree is at.
    git = lambda *args: subprocess.run(["git", "-C", system, *args], capture_output=True, text=True).stdout.strip()
    import hashlib
    with open(os.path.join(here, ".lake/build/efi/tdx", image_name, "BOOTX64.EFI"), "rb") as f:
        identity["image_sha256"] = hashlib.sha256(f.read()).hexdigest()
    identity["commit"] = git("rev-parse", "HEAD")
    if remote:
        identity["guest_at"] = remote
    identity["uncommitted_changes"] = bool(git("status", "--porcelain", "--untracked-files=no"))
    own_bid_verify()
    learn_duties()
    import threading
    threading.Thread(target=keep_learning, daemon=True).start()
    seen, done, last, ahead = None, 0, None, 0
    # The payment is made once. Every payment this run signs carries the count of transactions the wallet
    # had when the run began, so the chain takes at most one of them; and the run ends as soon as the
    # chain's count has moved, whether or not it saw the block that moved it as its own.
    unpaid = int(rpc("eth_getTransactionCount", [wallet.address, "latest"]), 16) if wallet else None
    try:
        while not slots_wanted or done < slots_wanted:
            head = rpc("eth_getBlockByNumber", ["latest", False])
            ahead = slots_gone(head, time.time())
            if (head["hash"], ahead) == seen or ahead > 3 or (ahead and later_block_known(head)):
                time.sleep(0.1)
                continue
            seen = (head["hash"], ahead)
            # The slot inputs guessed for the block that has just arrived, against what it had.
            if last and last.get("number") == int(head["number"], 16) and "randao" in last:
                last["randao_right"] = head["mixHash"] == last["randao"]
                last["withdrawals_right"] = \
                    [int(w["index"], 16) for w in head.get("withdrawals", [])] == [int(i) for i in last["withdrawals"]]
            # Whether the block built here is in the chain: it is the new head, or, had a head gone by
            # unseen, the block the chain has at its number.
            mined = None
            if last and ("hash" in last or "payment_hash" in last):
                mined = head if last["number"] == int(head["number"], 16) else \
                    rpc("eth_getBlockByNumber", [hex(last["number"]), False])
            ours = mined and (mined["hash"] in (last.get("hashes") or [last.get("hash")]) or
                              any(paid in mined.get("transactions", []) for paid in last.get("payment_hashes") or [last.get("payment_hash")]))
            if ours:
                last["landed"] = True
                last["hash"] = mined["hash"]
                landed(last, mined)
            if last:
                last.pop("randao", None), last.pop("withdrawals", None)
                log.write(json.dumps(last) + "\n")
                log.flush()
                print(json.dumps(last), flush=True)
            if last and last.get("landed") and wallet:
                # One is what was asked for, and with a top-up each further one is paid for. With no
                # payment a block in the chain costs nothing, and the run goes on.
                last = None
                break
            if wallet and int(rpc("eth_getTransactionCount", [wallet.address, head["number"]]), 16) != unpaid:
                last = {"number": int(head["number"], 16) + 1,
                        "stopped": "the wallet has paid, in a block this run did not see as its own"}
                break
            try:
                if with_proofs:
                    # As the host: the block that has just arrived is shown to the guest, which follows
                    # the chain. First of all, so that a slot this program then fails to build for is
                    # not a block the guest missed; and beside the gathering of what the next block
                    # needs, which does not wait for it.
                    def show():
                        try:
                            following["result"] = follow(guest, head)
                        except Exception as error:
                            followed["number"], followed["run"] = None, 0
                            following["result"] = (False, f"{type(error).__name__}: {error}"[:200])
                    following["thread"] = threading.Thread(target=show)
                    following["thread"].start()
                slot_time = int(head["timestamp"], 16) + 12 * (1 + ahead)
                last = build_one(guest, head, log, ahead)
                # The guest lacked state for a transaction it left out: asked again with that proven,
                # while the slot is still some way off.
                tries = 1
                while sealed and last.get("lacked") and not last.get("sealed_landed") and tries < 4 and \
                        time.time() < slot_time - 3:
                    last = build_one(guest, head, log, ahead)
                    tries += 1
                    last["tries"] = tries
                # The same slot again, for as long as a block begun now could still be in time: what is
                # pending grows all through the slot, and the first block was built when it had just
                # been emptied. Any of the blocks sent may be the one a relay holds, so each one's
                # hash and payment is kept to know it by.
                def round_of(r):
                    return {k: r[k] for k in ("ready_before_slot", "went_in", "value_eth", "gas_used", "allowed_ms", "judged",
                                              "signed", "relay_same", "sealed_landed", "status", "skipped", "relay", "not_sent", "unchecked",
                                              "request_bytes") if k in r} | \
                           {"seconds": (r.get("seconds") or {}).get("total"), "guest_seconds": (r.get("seconds") or {}).get("guest")}
                built, hashes, paid = [last], [last.get("hash")], [last.get("payment_hash")]
                recent = last
                while rebid:
                    # A round is begun only if, going by the one before, its block will be at the relay
                    # `ready` seconds before the slot: what gathering took then, and what the guest took
                    # and a little over. The last round that fits is begun as late as it can be, so
                    # that it has the most to choose from.
                    begin = begin_at(time.time(), slot_time - ready,
                                     need_of(recent.get("seconds") or {}, len(built) == 1))
                    if begin is None:
                        break
                    time.sleep(max(0, begin - time.time()))
                    if rpc("eth_getBlockByNumber", ["latest", False])["hash"] != head["hash"]:
                        break
                    if ahead and later_block_known(head):
                        break
                    again = build_one(guest, head, log, ahead)
                    if "seconds" in again:
                        recent = again
                        later[:] = later[-2:] + [again["seconds"]["inputs_and_trace"] + again["seconds"]["proofs"]]
                    built.append(again)
                    if again.get("status") == 0 and not again.get("not_sent"):
                        hashes.append(again.get("hash")), paid.append(again.get("payment_hash"))
                        last = again
                if rebid:
                    # What was being found out about the blocks behind the rounds is waited for.
                    checks.join()
                    last["rounds"] = [round_of(r) for r in built]
                    last["hashes"] = [h for h in hashes if h]
                    last["payment_hashes"] = [h for h in paid if h]
            except Exception as error:
                import traceback
                traceback.print_exc()
                last = {"number": int(head["number"], 16) + 1, "skipped": f"{type(error).__name__}: {error}"[:300]}
            if with_proofs:
                following["thread"].join()
            done += 1
    finally:
        checks.join()
        if last:
            if attest and not live and last.get("status") == 0:
                # Run for its reports and not sent anywhere: the last block is kept with its quote, so
                # that the checking of one can be tried without a block having landed.
                keep(last, "attested", False)
            last.pop("randao", None), last.pop("withdrawals", None)
            log.write(json.dumps(last) + "\n")
            print(json.dumps(last), flush=True)
        guest.stop()
        if sealed and sealing["marks"]:
            # Everything the host could have seen of the guest: what it sent and was sent (counted as it
            # went), every frame that crossed the guest's network, and the guest's console.
            with open(log_path + ".pcap", "rb") as f:
                frames = f.read()
            with open(guest.serial, "rb") as f:
                console = f.read()
            found = {"in_requests_and_answers": sealing["host_saw"],
                     "in_frames": sum(mark in frames for mark in sealing["marks"]),
                     "in_console": sum(mark in console or mark.hex().encode() in console for mark in sealing["marks"]),
                     "frames_bytes": len(frames), "looked_for": [len(mark) for mark in sealing["marks"]],
                     # To show the search finds what is there: the sender's address is something the host
                     # is told, so that it can prove the account, and must be in the frames.
                     "senders_address_in_frames": frames.count(raw(sender.address))}
            if with_proofs:
                # What the transaction touches: the wallet's address, the slot's number, and where each
                # lies in its trie. With proofs brought along the host is told none of them. (The
                # wrapped-ether contract itself is in every other block and says nothing.)
                found["touched_in_requests_and_answers"] = sealing["host_saw_about"]
                found["touched_in_frames"] = sum(mark in frames for mark in sealing["about"])
                found["touched_in_console"] = sum(mark.hex().encode() in console for mark in sealing["about"])
                # To show the search finds what is there: the contract's address is public and must be.
                found["contracts_address_in_frames"] = frames.count(raw(WETH))
            print(json.dumps({"sealed_transaction_seen_by_host": found}), flush=True)
            log.write(json.dumps({"sealed_transaction_seen_by_host": found}) + "\n")

if __name__ == "__main__":
    main()
