def presses(path):
    """Every press in the file, oldest first. A line that is not a press of the shape --press writes is
    none, and neither is anything in a file that cannot be read."""
    out = []
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except OSError:
        return out
    for line in lines:
        try:
            p = json.loads(line)
            if all(type(p[k]) is int and p[k] >= 0 for k in ("wei", "first", "last", "count", "at")) and type(p["wallet"]) is str:
                out.append(p)
        except (ValueError, KeyError, TypeError):
            pass
    return out

def spoken_for(pressed, count, slot, now):
    """Of the presses of the last 24 hours, the wei the wallet has paid for or may yet pay for, when its
    count of transactions is `count` and the slot being built for is `slot`. Presses made at the same
    count can pay once between them, so the largest of them stands for all. A count the chain has passed
    is taken as paid in full, whatever moved it; one it has not passed may pay while a press of it has
    slots left."""
    by_count = {}
    for p in pressed:
        if p["at"] > now - 86400 and (p["count"] != count or p["last"] >= slot):
            by_count[p["count"]] = max(by_count.get(p["count"], 0), p["wei"])
    return sum(by_count.values())

def press_for(pressed, address, count, slot, now):
    """The press that lets a payment be signed for `slot`, or None: the newest, if it is this wallet's, within
    the limits, names this slot, was made at the count of transactions the wallet still has, and does not
    take the day over its limit."""
    if not pressed:
        return None
    p = pressed[-1]
    good = (p["wallet"].lower() == address.lower() and 0 < p["wei"] <= MOST_A_PRESS and
            p["first"] <= slot <= p["last"] and p["last"] - p["first"] < MOST_SLOTS and
            p["count"] == count and p["at"] <= now and spoken_for(pressed, count, slot, now) <= MOST_A_DAY)
    return p if good else None

def press_now(eth, slots, now):
    """What --press does. Comes back with what to say and whether a press was written."""
    from decimal import Decimal, InvalidOperation
    try:
        wei = int(Decimal(eth) * 10**18)
    except InvalidOperation:
        return f"shadow: --press takes an amount in ETH, not {eth!r}", False
    slot = (int(now) - GENESIS_TIME) // 12
    count = int(rpc("eth_getTransactionCount", [presser.address, "latest"]), 16)
    holds = int(rpc("eth_getBalance", [presser.address, "latest"]), 16)
    pressed = presses(button_path)
    def state(pressed):
        current = press_for(pressed, presser.address, count, slot + 1, int(now))
        return (f"wallet {presser.address} holds {holds / 1e18:.5f} ETH; spoken for in the last 24 hours "
                f"{spoken_for(pressed, count, slot + 1, int(now)) / 1e18:.4f} of {MOST_A_DAY / 1e18} ETH; " +
                (f"armed: {current['wei'] / 1e18} ETH more for slots {current['first']} to {current['last']} (it is slot {slot})"
                 if current else "nothing armed"))
    if wei == 0:
        return state(pressed), False
    if wei < 0 or wei > MOST_A_PRESS:
        return f"shadow: a press is for at most {MOST_A_PRESS / 1e18} ETH", False
    if not 1 <= slots <= MOST_SLOTS:
        return f"shadow: a press is for 1 to {MOST_SLOTS} slots", False
    press = {"wei": wei, "first": slot + 1, "last": slot + slots, "count": count, "wallet": presser.address, "at": int(now)}
    if spoken_for(pressed + [press], count, slot + 1, int(now)) > MOST_A_DAY:
        return f"shadow: that would take the last 24 hours over {MOST_A_DAY / 1e18} ETH. {state(pressed)}", False
    # The payment and the most its gas can cost: 150,000 units at twice a base fee of 100 gwei.
    if holds < wei + 150000 * 200 * 10**9:
