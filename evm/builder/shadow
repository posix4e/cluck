def place_of(relay):
    host = relay.split("//", 1)[-1].split("/")[0]
    return IMAGE_RELAYS.index(host) if host in IMAGE_RELAYS else None
# A relay that answers with a status of 500 or more has said it cannot serve, not that the block was
# wrong. It is left alone for ten minutes, and for twice as long each time it says so again on being
# asked, up to 80 minutes; an answer of 200 or 202 ends that. The blocks go to the other relays
# meanwhile. (On 2026-11-25 Ultrasound's relay answered 503 to every post of three separate minutes,
# while it listed other builders' bids for the same slots. It was posted to again a second later each
# time, sixty times in all, which is no way to treat a server that says it is unavailable.)
resting = {}
def rested(relays, now):
    """Those of `relays` that are not being left alone at `now`."""
    return [relay for relay in relays if resting.get(place_of(relay), (0, 0))[0] <= now]
def heard(place, status, now):
    """What the relay at `place` in the image's list answered to a post."""
    if isinstance(status, int) and status >= 500:
        minutes = min(2 * resting[place][1], 80) if place in resting else 10
        resting[place] = (now + 60 * minutes, minutes)
    elif status in (200, 202):
        resting.pop(place, None)
