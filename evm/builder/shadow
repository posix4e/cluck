# ---- talking to the nodes -------------------------------------------------------------------------

def post(body, timeout=60):
    request = urllib.request.Request(RPC, json.dumps(body).encode(), {"Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.load(response)

def rpc(method, params, timeout=60):
    answer = post({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}, timeout)
    if "error" in answer:
        raise RuntimeError(f"{method}: {answer['error'].get('message', answer['error'])}")
    return answer["result"]

def batch(calls, workers=16, size=20):
    """Many (method, params), answered in order; errors come back as None."""
    chunks = [calls[i:i + size] for i in range(0, len(calls), size)]
    def one(chunk):
        body = [{"jsonrpc": "2.0", "id": i, "method": m, "params": p} for i, (m, p) in enumerate(chunk)]
        answers = sorted(post(body), key=lambda a: a["id"])
        return [a.get("result") for a in answers]
    with ThreadPoolExecutor(workers) as pool:
        return [r for part in pool.map(one, chunks) for r in part]

def get(base, path, timeout=20):
    request = urllib.request.Request(base + path, headers={"Accept": "application/json", "User-Agent": "builder-shadow"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.load(response)

def raw(text):
    return bytes.fromhex(text[2:])

# ---- the wallet, for a top-up -----------------------------------------------------------------------

P = 2**256 - 2**32 - 977
N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141
G = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798,
     0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)

try:
    from Cryptodome.Hash import keccak as _keccak
    def keccak(data):
        return _keccak.new(digest_bits=256, data=data).digest()
except ImportError:
    # A process for every hash: slow, and enough where hashes are few.
    def keccak(data):
        return subprocess.run(["openssl", "dgst", "-KECCAK-256", "-binary"], input=data, capture_output=True, check=True).stdout

def ec_add(a, b):
    if a is None: return b
    if b is None: return a
    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None
    slope = (3 * a[0] * a[0] * pow(2 * a[1], -1, P) if a == b else (b[1] - a[1]) * pow(b[0] - a[0], -1, P)) % P
    x = (slope * slope - a[0] - b[0]) % P
    return (x, (slope * (a[0] - x) - a[1]) % P)

def ec_mul(k, point):
    out = None
    while k:
        if k & 1: out = ec_add(out, point)
        point, k = ec_add(point, point), k >> 1
    return out

class Wallet:
    def __init__(self, path):
        from cryptography.hazmat.primitives import serialization
        with open(path, "rb") as f:
            self.key = serialization.load_pem_private_key(f.read(), None)
        numbers = self.key.public_key().public_numbers()
        self.point = (numbers.x, numbers.y)
        self.address = "0x" + keccak(numbers.x.to_bytes(32, "big") + numbers.y.to_bytes(32, "big"))[-20:].hex()

    def pay(self, nonce, base_fee, wei, number, fee_recipient, priority):
        """A transaction that pays `wei` to the fee recipient of the block it is in, if that block has this
        number and this fee recipient, and otherwise does nothing: as it goes on the wire, with how the
        pool would list it.

        It creates a contract whose making is the whole of it. The code that runs looks at the block's
        number and fee recipient; if they are the ones named it sends what the transaction carries to the
        fee recipient and leaves an account with no code behind, and if not it reverts and the money stays
        where it was. So a copy of this transaction that gets out is worth nothing in any other slot, or in
        a block of this slot that pays someone else: all it can cost there is its gas."""
        from cryptography.hazmat.primitives.asymmetric import ec, utils
        from cryptography.hazmat.primitives import hashes
        code = (bytes.fromhex("4363") + struct.pack(">I", number) + bytes.fromhex("144173") + raw(fee_recipient) +
                bytes.fromhex("1416602557" "5f5ffd" "5b" "5f5f5f5f34415af1" "603457" "5f5ffd" "5b00"))
        assert len(code) == 54 and code[0x25] == 0x5b and code[0x34] == 0x5b
        gas = 150000
        cap = 2 * base_fee + priority
        body = [1, nonce, priority, cap, gas, b"", wei, code, []]
        digest = keccak(b"\x02" + rlp(body))
        r, s = utils.decode_dss_signature(self.key.sign(digest, ec.ECDSA(utils.Prehashed(hashes.SHA256()))))
        if s > N // 2:
            s = N - s
        # Which of the two points with abscissa r was used: the one from which the key comes back.
        z = int.from_bytes(digest, "big")
        parity = None
        for candidate in (0, 1):
            y = pow(r**3 + 7, (P + 1) // 4, P)
            if y % 2 != candidate:
                y = P - y
            inverse = pow(r, -1, N)
            if ec_add(ec_mul(s * inverse % N, (r, y)), ec_mul(-z * inverse % N, G)) == self.point:
                parity = candidate
        wire = b"\x02" + rlp(body + [parity, r, s])
        listed = {"from": self.address, "to": None, "gas": hex(gas), "value": hex(wei), "input": "0x" + code.hex(),
                  "nonce": hex(nonce), "type": "0x2", "maxFeePerGas": hex(cap), "maxPriorityFeePerGas": hex(priority),
                  "hash": "0x" + keccak(wire).hex(), "wire": wire}
        return listed

    def signed(self, body):
        """A transaction of the fee-market kind with these fields, signed: as it goes on the wire, and the
        two numbers of its signature, which are in no other transaction."""
        from cryptography.hazmat.primitives.asymmetric import ec, utils
        from cryptography.hazmat.primitives import hashes
        digest = keccak(b"\x02" + rlp(body))
        r, s = utils.decode_dss_signature(self.key.sign(digest, ec.ECDSA(utils.Prehashed(hashes.SHA256()))))
        if s > N // 2:
            s = N - s
        z = int.from_bytes(digest, "big")
        parity = None
        for candidate in (0, 1):
            y = pow(r**3 + 7, (P + 1) // 4, P)
            if y % 2 != candidate:
                y = P - y
            inverse = pow(r, -1, N)
            if ec_add(ec_mul(s * inverse % N, (r, y)), ec_mul(-z * inverse % N, G)) == self.point:
                parity = candidate
        return b"\x02" + rlp(body + [parity, r, s]), [r.to_bytes(32, "big"), s.to_bytes(32, "big")]

    def wrap_nothing(self, nonce, base_fee, priority=1):
        """A deposit of nothing into the wrapped-ether contract: a call that runs a contract's code and
        reads and writes one slot of its storage, the wallet's balance there, and changes nothing."""
        return self.signed([1, nonce, priority, base_fee + base_fee // 4 + priority, 60000, raw(WETH), 0,
                            bytes.fromhex("d0e30db0"), []])

    def to_itself(self, nonce, base_fee, priority=1):
        """A transfer of nothing from the wallet to itself, as it goes on the wire, and the two numbers of
        its signature, which are in no other transaction."""
        from cryptography.hazmat.primitives.asymmetric import ec, utils
        from cryptography.hazmat.primitives import hashes
        # It pays next to nothing over the base fee and allows for the base fee rising by a quarter, so a
        # copy that got out would soon be good for nothing; it is signed for a stand-in and goes no further.
        body = [1, nonce, priority, base_fee + base_fee // 4 + priority, 21000, raw(self.address), 0, b"", []]
        digest = keccak(b"\x02" + rlp(body))
        r, s = utils.decode_dss_signature(self.key.sign(digest, ec.ECDSA(utils.Prehashed(hashes.SHA256()))))
        if s > N // 2:
            s = N - s
        z = int.from_bytes(digest, "big")
        parity = None
        for candidate in (0, 1):
            y = pow(r**3 + 7, (P + 1) // 4, P)
            if y % 2 != candidate:
                y = P - y
            inverse = pow(r, -1, N)
            if ec_add(ec_mul(s * inverse % N, (r, y)), ec_mul(-z * inverse % N, G)) == self.point:
                parity = candidate
        return b"\x02" + rlp(body + [parity, r, s]), [r.to_bytes(32, "big"), s.to_bytes(32, "big")]

