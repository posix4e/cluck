#!/usr/bin/env python3
"""Reads the machine code of the signing key's field arithmetic in a built image and says what in it could
let a secret decide the time it takes.

    scripts/check-secret-code dev|tdx          (from evm/, after: scripts/build-efi dev|tdx)
    scripts/check-secret-code lib              (from evm/, after: lake build; see the end of this note)

`Evm/Sign/Field.lean` is written so that no value of a field element decides a branch, an address or a
division. This looks at what the Lean and C compilers made of it, in the objects the image was linked
from, and fails unless:

- the product, the sum and the reduction (`Fp.mul`, `Fp.add`, `Fp.reduce`) have no conditional jump and
  no division instruction at all;
- the difference and the choice (`Fp.sub`, `Fp.select`) have no division and at most four conditional
  jumps each. Four is what Lean's reuse of two arguments in place makes: jumps on a reference count, which
  is how many things hold an argument and not what it holds. That those four are on reference counts was
  read by hand in two builds; this counts them and does not look at what they test.

It reads one build. It does not follow the functions these call (the allocator, `silo_secret_select`,
which `Mini/Constant.lean` checks in its own way), the curve arithmetic above them, whose only branches are
on the position in the key and on reference counts but which this does not check, or anything about the
processor. Exit status 0 only if every function is found and passes.

`dev` and `tdx` look as well, in the same image, at the arithmetic a key exchange and a sealed message go
through (`Tls/`), and `lib` looks at that alone as `lake build` compiled it for Lean's own runtime: X25519's field (`Fe.carry` with no conditional jump at all;
`Fe.mul`, `Fe.add`, `Fe.sub`, `Fe.mulSmall`, `Fe.select` with at most four, on reference counts as above),
one step of Poly1305 (at most four), and ChaCha20's quarter round (none). No division in any. As above it
counts and does not read: that `X25519.ladder` hands a key's bit to nothing but `Fe.select` was read in
the generated C by hand, after a first version that compared two truth values was found compiled to a
branch on the bit.
"""
import glob, os, re, subprocess, sys     # and binutils' nm and objdump

if len(sys.argv) != 2 or sys.argv[1] not in ("dev", "tdx", "lib"):
    sys.exit(__doc__)
here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
strict = ["X25519_Fe_carry", "ChaCha20_quarter"]
counted = ["X25519_Fe_mul", "X25519_Fe_add", "X25519_Fe_sub", "X25519_Fe_mulSmall", "X25519_Fe_select", "Poly1305_step"]
if sys.argv[1] == "lib":
    objects = glob.glob(os.path.join(here, ".lake/build/ir/Tls/*.c.o.export"))
    wanted = {f"lp_evm_Tls_{name}": name for name in strict + counted}
else:
    # The image holds both: the signing key's field, and the key exchange's and the sealing's arithmetic.
    objects = glob.glob(os.path.join(here, ".lake/build/efi", sys.argv[1], "evm-os/obj/*.o"))
    tls_strict, tls_counted = strict, counted
    strict = ["Fp_mul", "Fp_add", "Fp_reduce"]
    counted = ["Fp_sub", "Fp_select"]
    wanted = {f"lp_evm_Evm_Sign_{name}": name for name in strict + counted}
    wanted.update({f"lp_evm_Tls_{name}": name for name in tls_strict + tls_counted})
    strict, counted = strict + tls_strict, counted + tls_counted
found, failed = {}, 0
for path in objects:
    symbols = subprocess.run(["nm", path], capture_output=True, text=True).stdout
    for symbol in wanted:
        if re.search(rf" [Tt] {symbol}$", symbols, re.M):
            listing = subprocess.run(["objdump", "-d", "--no-show-raw-insn", f"--disassemble={symbol}", path],
                                     capture_output=True, text=True).stdout
            found[symbol] = [m.group(1).split() for m in re.finditer(r"^\s*[0-9a-f]+:\s+(.*)$", listing, re.M)]
for symbol, name in wanted.items():
    if symbol not in found or not found[symbol]:
        print(f"{name}: not found in the image's objects")
        failed += 1
        continue
    code = found[symbol]
    jumps = [i for i, ins in enumerate(code) if ins and ins[0].startswith("j") and ins[0] not in ("jmp", "jmpq")]
    divisions = [ins for ins in code if ins and ins[0].startswith(("div", "idiv"))]
    ok = not divisions and (not jumps if name in strict else len(jumps) <= 4)
    failed += not ok
    print(f"{name}: {len(code)} instructions, {len(jumps)} conditional jumps, {len(divisions)} divisions: "
          f"{'as it should be' if ok else 'NOT AS IT SHOULD BE'}")
sys.exit(1 if failed else 0)
