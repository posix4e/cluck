#!/usr/bin/env python3
"""How much memory the guest's following of the chain takes: saved blocks put to `Evm/Follow.lean` one after
another, in one process on the guest's own runtime, and the most memory the process ever held.

    scripts/follow-memory BLOCK.req...      (from evm/, after: lake build follow-run && scripts/build-min follow-run)

The blocks are stateless requests as `witness/fetch` writes them, in the chain's order. The minimal
runtime takes one region and hands it out from the front, never giving any back, so the process's largest
resident size is how far the allocator got into it. The guest's heap is 512 MiB (scripts/build-efi); the
same blocks in the same order must stay under that with room for what else the guest holds."""
import os, resource, struct, subprocess, sys
here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if len(sys.argv) < 2: sys.exit(__doc__)
run = subprocess.Popen([os.path.join(here, ".lake/build/bin/follow-run-min")], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
import threading
said = []
reader = threading.Thread(target=lambda: said.extend(run.stdout.read().decode().splitlines()))
reader.start()
for path in sys.argv[1:]:
    with open(path, "rb") as f: request = b"JFOL1" + f.read()[5:]
    run.stdin.write(struct.pack(">I", len(request)) + request)
run.stdin.close()
status = run.wait(); reader.join()
followed = sum("status 0," in line for line in said)
peak = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss / 1024
print("\n".join(said[-2:]))
print(f"{followed} of {len(sys.argv) - 1} followed; the process ended with status {status}; the most memory it held: {peak:.0f} MiB")
sys.exit(0 if status == 0 and followed == len(sys.argv) - 1 else 1)
