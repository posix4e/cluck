#!/usr/bin/env python3
"""Writes the cases `tls-test` checks `Tls/Hpke.lean` against: messages sealed by OpenSSL's own HPKE
(`OSSL_HPKE_*` in libcrypto, called here directly, since nothing else on this machine speaks RFC 9180).

    scripts/hpke-vectors > Tls/hpke.txt        (from evm/)

Each line: `hpke`, the receiver's private and public key, the sender's public half, `info`, the data
beside the message, the sealed message, and what must come of opening it: the message, or nothing for a
case in which one byte of something was changed after sealing. Suite: X25519, HKDF-SHA-256,
ChaCha20-Poly1305, base mode."""
import ctypes, ctypes.util, os, random
from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey
from cryptography.hazmat.primitives import serialization

lib = ctypes.CDLL(ctypes.util.find_library("crypto"))
class Suite(ctypes.Structure):
    _fields_ = [("kem", ctypes.c_uint16), ("kdf", ctypes.c_uint16), ("aead", ctypes.c_uint16)]
suite = Suite(0x0020, 0x0001, 0x0003)
lib.OSSL_HPKE_CTX_new.restype = ctypes.c_void_p
lib.OSSL_HPKE_CTX_new.argtypes = [ctypes.c_int, Suite, ctypes.c_int, ctypes.c_void_p, ctypes.c_char_p]
lib.OSSL_HPKE_encap.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.POINTER(ctypes.c_size_t), ctypes.c_char_p, ctypes.c_size_t, ctypes.c_char_p, ctypes.c_size_t]
lib.OSSL_HPKE_seal.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.POINTER(ctypes.c_size_t), ctypes.c_char_p, ctypes.c_size_t, ctypes.c_char_p, ctypes.c_size_t]
lib.OSSL_HPKE_CTX_free.argtypes = [ctypes.c_void_p]

def seal(recipient, info, aad, plain):
    """OpenSSL seals `plain` to `recipient`: the sender's public half and the sealed message."""
    ctx = lib.OSSL_HPKE_CTX_new(0, suite, 0, None, None)          # base mode, as the sender
    assert ctx
    enc, enc_size = ctypes.create_string_buffer(32), ctypes.c_size_t(32)
    assert lib.OSSL_HPKE_encap(ctx, enc, ctypes.byref(enc_size), recipient, len(recipient), info, len(info)) == 1
    out, out_size = ctypes.create_string_buffer(len(plain) + 16), ctypes.c_size_t(len(plain) + 16)
    assert lib.OSSL_HPKE_seal(ctx, out, ctypes.byref(out_size), aad, len(aad), plain, len(plain)) == 1
    lib.OSSL_HPKE_CTX_free(ctx)
    return enc.raw[:enc_size.value], out.raw[:out_size.value]

rng = random.Random(0x9180)
some = lambda n: bytes(rng.getrandbits(8) for _ in range(n))
show = lambda b: b.hex() or "-"
spoil = lambda b, i: b[:i] + bytes([b[i] ^ 1]) + b[i + 1:]
for size in [1, 2, 15, 16, 17, 63, 64, 65, 110, 255, 1000] * 3 + [4096, 20000]:      # OpenSSL seals no empty message
    key = X25519PrivateKey.generate()
    secret = key.private_bytes(serialization.Encoding.Raw, serialization.PrivateFormat.Raw, serialization.NoEncryption())
    public = key.public_key().public_bytes_raw()
    info, aad, plain = some(rng.choice([0, 5, 40])), some(rng.choice([0, 3, 32])), some(size)
    enc, sealed = seal(public, info, aad, plain)
    print("hpke", show(secret), show(public), show(enc), show(info), show(aad), show(sealed), "01" + plain.hex())
    # The same with one thing changed: it must not open.
    print("hpke", show(secret), show(public), show(enc), show(info), show(aad), show(spoil(sealed, len(sealed) // 2)), "00")
    if size > 300: continue
    print("hpke", show(secret), show(public), show(spoil(enc, 3)), show(info), show(aad), show(sealed), "00")
    print("hpke", show(secret), show(public), show(enc), show(info + b"x"), show(aad), show(sealed), "00")
    print("hpke", show(secret), show(public), show(enc), show(info), show(aad + b"x"), show(sealed), "00")
    print("hpke", show(secret), show(public), show(enc), show(info), show(aad), show(spoil(sealed, len(sealed) - 1)), "00")
    print("hpke", show(spoil(secret, 9)), show(public), show(enc), show(info), show(aad), show(sealed), "00")
# A public half made so that the exchange comes to nothing: refused, whatever follows.
print("hpke", show(some(32)), show(some(32)), show(bytes(32)), "-", "-", show(some(40)), "00")
