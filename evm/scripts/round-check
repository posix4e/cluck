#!/usr/bin/env python3
"""Tests how builder/shadow decides how many transactions a round carries (`most_for`, `learn_pace`),
whether and when another round is begun for the same head (`need_of`, `begin_at`), and which slot is
built for when a slot goes by with no block (`slots_gone`), and which relays are left alone after
saying they cannot serve (`heard`, `rested`), and when a relay's refusal says the slot is over (`slot_over`).

    scripts/round-check [FILE]           (from evm/; FILE is builder/shadow unless said)

builder/shadow is loaded as it would be started for a guest somewhere else; nothing is asked of a node
or a guest and no round is run. The cases are the arithmetic: that a round is given what fits in its
time, best paying first; that what was proposed before for the same head costs no gathering again; that
a later round never gets fewer than the one before with a few more; that what rounds cost is learned
from several and not from one; and that a slot's last round is begun so as to end when the block is
wanted, also after a first round that was slow.

Not tested here: that rounds with fewer transactions make for more and earlier bids when the pool is
full, which needs a guest and a full pool (TODO.md says what was run).
"""
import importlib.machinery, importlib.util, os, sys

here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.dont_write_bytecode = True
path = sys.argv[1] if len(sys.argv) > 1 else os.path.join(here, "builder/shadow")
os.environ.pop("SHADOW_PACE", None)
sys.argv = ["shadow", "--guest", "127.0.0.1:1", "--live", "--guest-sends", "--rebid", "--relays", "https://aestus.live"]
loader = importlib.machinery.SourceFileLoader("shadow", path)
shadow = importlib.util.module_from_spec(importlib.util.spec_from_loader("shadow", loader))
loader.exec_module(shadow)

failed = []
def check(name, good, got=None):
    print(f"{'ok  ' if good else 'FAIL'}  {name}")
    if not good:
        failed.append(name)
        if got is not None:
            print(f"      got {got!r}")

txs = [{"hash": f"0x{n:064x}"} for n in range(400)]
def set_pace(gather, guest):
    shadow.pace["gather"], shadow.pace["guest"] = [gather] * 3, [guest] * 3

set_pace(0.008, 0.008)
got = shadow.most_for(txs, set(), 4.21)
check("a full pool and 4.2 s: 250 transactions, not 400", got == 250, got)
check("  time for everything: everything", shadow.most_for(txs, set(), 60) == 400)
check("  time for nothing: thirty all the same", shadow.most_for(txs, set(), 0.1) == 30)
check("  fewer pending than fit: all of them", shadow.most_for(txs[:100], set(), 4.2) == 100)
check("  nothing pending: none", shadow.most_for([], set(), 4.2) == 0)
before = {tx["hash"] for tx in txs[:250]}
got = shadow.most_for(txs, before, 4.21)
check("what was proposed before costs no gathering: the next round carries more", got == 375, got)
got = shadow.most_for(txs, before, 4.21, guest_each=0.02)
check("  fewer when the guest took longer over this head's last round than rounds usually take", got == 200, got)
got = shadow.most_for(txs, before, 1.0, guest_each=0.02, floor=275)
check("a later round with little time: the round before and a few more, never fewer", got == 275, got)
got = shadow.most_for(txs[:260], before, 1.0, guest_each=0.02, floor=275)
check("  and no more than are pending", got == 260, got)

# What rounds cost is the middle one of the last three: one odd round changes nothing, two do.
set_pace(0.008, 0.008)
shadow.learn_pace(100, 100, 0.8, 5.2)          # a round the guest took 5 s over: 50 ms a transaction
check("one slow round is not believed", shadow.each("guest") == 0.008, shadow.pace)
shadow.learn_pace(100, 100, 0.8, 5.2)
check("two are", abs(shadow.each("guest") - 0.05) < 1e-9, shadow.pace)
for _ in range(2):
    shadow.learn_pace(100, 100, 0.4, 0.8)
check("two quick ones after, and the quick pace is back", abs(shadow.each("guest") - 0.006) < 1e-9 and abs(shadow.each("gather") - 0.004) < 1e-9, shadow.pace)
kept = dict(shadow.pace)
shadow.learn_pace(5, 10, 3.0, 3.0)
check("a round of a few transactions teaches nothing", shadow.pace == kept, shadow.pace)
shadow.learn_pace(100, 100, 0.0, 0.1)
check("a cost is never taken for nothing", min(shadow.pace["guest"]) >= 0.0005 and min(shadow.pace["gather"]) >= 0.0005, shadow.pace)
check("no more than three rounds are remembered", len(shadow.pace["guest"]) == 3 and len(shadow.pace["gather"]) == 3, shadow.pace)

# Whether another round is begun for the same head, and when (`need_of`, `begin_at`).
near = lambda a, b: a is not None and abs(a - b) < 1e-9
shadow.later[:] = [0.3, 0.35, 0.6]
shadow.FINISHING = 0.25                                                  # as builder/feed starts it
full = {"inputs_and_trace": 1.49, "proofs": 2.28, "guest": 0.83}        # slot 15731104, 2026-11-25
got = shadow.need_of(full, False)
check("a round needs what the one before took, and the time kept back for finishing", near(got, 3.77 + 0.83 + 0.25), got)
got = shadow.need_of(full, True)
check("  after a head's first round, the gathering is the later rounds': the middle of three and half again", near(got, 0.525 + 0.83 + 0.25), got)
got = shadow.need_of({"inputs_and_trace": 0.1, "proofs": 0.2, "guest": 0.5}, True)
check("  unless the first round's own was less", near(got, 0.3 + 0.5 + 0.25), got)
got = shadow.need_of({}, False)
check("  a round that left no times is taken for an ordinary one", near(got, 1.0 + 0.6 + 0.25), got)
check("time for many rounds: the next begins now", shadow.begin_at(100.0, 110.0, 1.5) == 100.0)
got = shadow.begin_at(100.0, 103.2, 1.5)
check("time for two and little over: one, begun as late as it can be", near(got, 101.7), got)
got = shadow.begin_at(100.0, 103.5, 1.5)
check("  2.3 times: begun now, and there is time for another after it", got == 100.0, got)
check("time for exactly one: now", near(shadow.begin_at(100.0, 101.5, 1.5), 100.0))
check("less than one: no more rounds", shadow.begin_at(100.0, 101.4, 1.5) is None)
# The round that is waited for is begun sooner by what such rounds have been seen to want (`early`).
got = shadow.begin_at(100.0, 103.2, 1.5, 0.2)
check("the round waited for, with a fifth of a second to spare: begun that much sooner", near(got, 101.5), got)
check("  and never before now", near(shadow.begin_at(100.0, 101.6, 1.5, 0.5), 100.0))
check("  a round that is not waited for is begun now all the same", shadow.begin_at(100.0, 110.0, 1.5, 0.5) == 100.0)
check("  and to spare is not time for a round: less than one is still no round", shadow.begin_at(100.0, 101.4, 1.5, 0.5) is None)
shadow.early["by"] = 0.0
shadow.learn_early(True)
check("a waited-for round that held as many as those before: the next is begun four thousandths later", near(shadow.early["by"], -0.004))
shadow.learn_early(False)
check("one with fewer in it: the next is begun six hundredths of a second sooner", near(shadow.early["by"], 0.056))
for _ in range(15):
    shadow.learn_early(True)
check("fifteen that held, and it is back where it was", near(shadow.early["by"], -0.004), shadow.early)
for _ in range(40):
    shadow.learn_early(True)
check("never more than a tenth of a second later than the round before says", near(shadow.early["by"], -0.1), shadow.early)
for _ in range(20):
    shadow.learn_early(False)
check("never more than six tenths of a second", near(shadow.early["by"], 0.6), shadow.early)
shadow.early["by"] = 0.0
# That slot's first round was over 5.11 s before the slot, the block wanted 0.7 s before it.
check("a full pool's slow first round is followed by a second", shadow.begin_at(0.0, 4.41, shadow.need_of(full, True)) == 0.0
      and shadow.begin_at(0.0, 4.41, shadow.need_of(full, False)) is None)

# Which slot is built for when no block has come (`slots_gone`): the head's slot began at 1000.
head = {"timestamp": hex(1000)}
check("a head two seconds old: the slot after it", shadow.slots_gone(head, 1002.0) == 0)
check("  until that slot is seven seconds old with no block", shadow.slots_gone(head, 1018.9) == 0)
check("  then the one after, on the same parent", shadow.slots_gone(head, 1019.0) == 1 and shadow.slots_gone(head, 1030.9) == 1)
check("  and so on", shadow.slots_gone(head, 1031.0) == 2 and shadow.slots_gone(head, 1100.0) == 7)
# A block that came late is the beacon node's head before it is the execution node's.
at = {"slot": (1000 - shadow.GENESIS_TIME) // 12}
shadow.get = lambda base, path, timeout=20: {"data": {"header": {"message": {"slot": str(at["slot"])}}}}
check("the beacon node's head is the parent: nothing later is known", not shadow.later_block_known(head))
at["slot"] += 1
check("  it has a block after the parent: nothing more is built on the parent", shadow.later_block_known(head))
shadow.rebid = False
check("without --rebid nothing is built on an old head", shadow.slots_gone(head, 1100.0) == 0)
shadow.rebid = True
kept = shadow.kept_of({"hash": "0xaa"})
kept.update(slot_inputs=1, system=2, round=3, proposed={"0x01"})
kept["proofs"]["0xbb"] = "proven"
again = shadow.kept_of({"hash": "0xaa"}, 1)
check("the same parent for a later slot: its proofs are kept, what the slot fixed is asked again",
      again["proofs"] == {"0xbb": "proven"} and again["proposed"] == {"0x01"} and not {"slot_inputs", "system", "round"} & set(again), sorted(again))
check("  and another parent starts with nothing", shadow.kept_of({"hash": "0xcc"})["proofs"] == {})

# A relay that says it cannot serve is left alone for a while (`heard`, `rested`).
four = ["https://" + host for host in shadow.IMAGE_RELAYS]
shadow.resting.clear()
check("no relay has said anything: all four are posted to", shadow.rested(four, 1000.0) == four)
shadow.heard(1, 503, 1000.0)
check("one answers 503: the other three, for ten minutes", shadow.rested(four, 1001.0) == [four[0], four[2], four[3]]
      and shadow.rested(four, 1599.0) == [four[0], four[2], four[3]] and shadow.rested(four, 1600.0) == four)
shadow.heard(1, 503, 1600.0)
check("  503 again when asked after that: twenty minutes", len(shadow.rested(four, 2799.0)) == 3 and len(shadow.rested(four, 2800.0)) == 4)
for _ in range(5):
    shadow.heard(1, 500, 5000.0)
check("  never longer than eighty", len(shadow.rested(four, 5000.0 + 80 * 60 - 1)) == 3 and len(shadow.rested(four, 5000.0 + 80 * 60)) == 4)
shadow.heard(1, 202, 9800.0)
shadow.heard(1, 503, 9900.0)
check("  an answer of 200 or 202 and it is ten minutes again the next time", len(shadow.rested(four, 9900.0 + 599)) == 3 and len(shadow.rested(four, 9900.0 + 600)) == 4)
shadow.resting.clear()
shadow.heard(2, 400, 1000.0)
shadow.heard(3, "no answer", 1000.0)
check("a refusal or no answer is not that: the relay is posted to as before", shadow.rested(four, 1001.0) == four)

# What a guest that keeps what it is given is given (`new_to`, `taken`; the guest's side is `Build.Kept`
# in Evm/Build.lean, and build-test has it).
if hasattr(shadow, "new_to"):
    fresh = lambda: {"nodes": set(), "codes": set(), "chain": [], "given": 0}
    chain = [f"h{n}" for n in range(255)]
    nodes, codes = {"0x" + "ab" * 100, "0x" + "cd" * 50}, [b"x" * 30, b"y" * 20]
    first = shadow.new_to(fresh(), nodes, codes, chain)
    check("a guest that holds nothing is given everything", first == (sorted(nodes), codes, chain), first)
    told = shadow.taken(fresh(), *first[:2], chain)
    check("and what it was given is counted in bytes, as the guest counts it", told["given"] == 200, told["given"])
    check("the same again gives it nothing, and no header", shadow.new_to(told, nodes, codes, chain) == ([], [], []))
    more = shadow.new_to(told, nodes | {"0x" + "ef" * 10}, codes + [b"z"], chain[1:] + ["h255"])
    check("on the next block it is given what is new and the one new header",
          more == (["0x" + "ef" * 10], [b"z"], ["h255"]), more)
    rival = shadow.new_to(told, nodes, codes, chain[:-1] + ["other"])
    check("on another block at the same height, that block's header alone", rival[2] == ["other"], rival[2])
    back = shadow.new_to(told, nodes, codes, ["g"] + chain[:-1])
    check("on the block before, which wants a header older than any it has: every header", len(back[2]) == 255, back[2][:2])
    young = shadow.taken(fresh(), [], [], chain[:40])
    check("on the block before in a chain not yet 255 long: that block's parent's header, since given none it would take all it has",
          shadow.new_to(young, nodes, codes, chain[:39])[2] == chain[38:39], shadow.new_to(young, nodes, codes, chain[:39])[2])
    apart = shadow.new_to(told, nodes, codes, [f"k{n}" for n in range(255)])
    check("on a chain it has nothing of, every header", len(apart[2]) == 255)
    gap = shadow.new_to(told, nodes, codes, chain[3:] + ["a", "b", "c"])
    check("three blocks on, the three new headers", gap[2] == ["a", "b", "c"], gap[2])
    short = shadow.new_to({**fresh(), "chain": chain[100:]}, nodes, codes, chain[1:] + ["h255"])
    check("when it has too few headers before the new one to make 255, every header", len(short[2]) == 255)
    big = shadow.taken(fresh(), ["0x" + "00" * (shadow.KEPT_LIMIT + 1)], [], chain)
    check("past its limit it holds nothing: not known, so it is told to forget first", big is None)
    edge = shadow.taken(fresh(), ["0x" + "00" * shadow.KEPT_LIMIT], [], chain)
    check("at its limit it still holds it", edge is not None and edge["given"] == shadow.KEPT_LIMIT)

# What is proposed to a guest whose block may go on from the one before (--continues).
went = [txs[7], txs[3], txs[5]]
got = shadow.those_in_first(went, txs[:6])
check("going on: the block before comes first, in its own order, and then what else is proposed, once each",
      got == [txs[7], txs[3], txs[5], txs[0], txs[1], txs[2], txs[4]], [t["hash"][-2:] for t in got])
check("  a transaction of the block before that the pool has let go of is proposed all the same", txs[7] in got and txs[7] not in txs[:6])
check("  with no block before, what is proposed is as it was", shadow.those_in_first([], txs[:6]) == txs[:6])
check("  and none of it is asked for unless the feeder is told to", not shadow.continues and not shadow.keeps and shadow.dump_dir is None)

# A relay that has said 429 is posted to less often, and still gets the slot's last block.
shadow.FINISHING = 0.25
shadow.paced.clear(), shadow.last_post.clear()
due = 1000.0
check("a relay that never said 429 is posted to every round", shadow.may_post(1, 990.0, due, 0.3, 0.8) and shadow.may_post(1, 999.9, due, 0.3, 0.8))
shadow.heard(1, 429, 990.0)
check("one that says it is posted to at most every 1.3 s from then on", shadow.paced == {1: 1.3}, shadow.paced)
shadow.last_post[1] = 990.0
check("  not half a second after the last post", not shadow.may_post(1, 990.5, due, 0.3, 0.8))
check("  again when 1.3 s have gone by and the slot's last round is still far off", shadow.may_post(1, 991.3, due, 0.3, 0.8))
shadow.last_post[1] = 997.0
check("  not when that would leave it too little time before the slot's last round", not shadow.may_post(1, 998.4, due, 0.3, 0.8))
check("  but in the slot's last round, after which no other could be back in time", shadow.may_post(1, 999.0, due, 0.3, 0.8))
check("  the other relays are posted to all the while", shadow.may_post(0, 998.4, due, 0.3, 0.8) and shadow.may_post(2, 990.5, due, 0.3, 0.8))
shadow.heard(1, 429, 999.0)
check("saying it again makes that 1.6 s, and 200 does not undo it", shadow.paced == {1: 1.6} and (shadow.heard(1, 200, 999.5) or shadow.paced == {1: 1.6}), shadow.paced)
for _ in range(40):
    shadow.heard(1, 429, 999.0)
check("  never more than six seconds", shadow.paced == {1: 6.0}, shadow.paced)
# A slot's rounds as they have run: every 0.65 s for 8 s, the relay's limit taken as one post a second.
shadow.paced.clear(), shadow.last_post.clear()
shadow.heard(1, 429, 0.0)
posts, t = [], 991.0
while t + 0.3 + 0.25 <= due:
    if shadow.may_post(1, t, due, 0.3, 0.8):
        posts.append(t)
        shadow.last_post[1] = t
    t = round(t + 0.65, 2)
gaps = [round(b - a, 2) for a, b in zip(posts, posts[1:])]
check("over a slot's rounds 0.65 s apart: posted to every other round, never twice within a second, and in the last round",
      posts and min(gaps) >= 1.3 and posts[-1] >= due - 0.3 - 0.25 - 0.65, (posts, gaps))

# Wide transactions wait for a round with room for them.
check("a transaction's width is its accounts and a quarter of the storage slots it read",
      shadow.width_of({"a": {"storage": {str(i): "0x1" for i in range(1100)}}, "b": {}, "c": {"storage": {"1": "0x1"}}}) == 3 + 275)
shadow.width.clear()
shadow.width.update({txs[1]["hash"]: 800, txs[2]["hash"]: 120, txs[3]["hash"]: 151})
check("a head's first round has room for wide transactions of 150 between them, and no more",
      shadow.room_for(True, 10.0) == 150 and shadow.narrow(txs[:5], shadow.room_for(True, 10.0)) == [txs[0], txs[2], txs[4]]
      and shadow.left_wide["spent"] == 120, shadow.left_wide)
check("  a later round with nine seconds left takes the one of 800, and then has no room for the others",
      shadow.narrow(txs[:5], shadow.room_for(False, 9.0)) == [txs[0], txs[1], txs[4]], shadow.room_for(False, 9.0))
check("  one with three seconds left takes the one of 120 and not the one of 151 after it",
      shadow.narrow(txs[:5], shadow.room_for(False, 3.0)) == [txs[0], txs[2], txs[4]], shadow.room_for(False, 3.0))
check("  with no time left there is still room for sixty", shadow.room_for(False, 0.2) == 60 and shadow.room_for(False, -3) == 60)
check("  a transaction never traced is taken for narrow, and one already in the block is always proposed and takes no room",
      shadow.narrow(txs[4:6], 60) == txs[4:6] and shadow.narrow(txs[:3], 120, {txs[1]["hash"]}) == txs[:3])
shadow.width.update({txs[5]["hash"]: 60, txs[6]["hash"]: 60})
check("  those of sixty or less are proposed however many", shadow.narrow(txs[4:7], 60) == txs[4:7] and shadow.left_wide["spent"] == 0)
shadow.width.clear()

# Rounds may go on into the slot, until a relay says the slot is over.
check("a relay's refusal that comes after the slot began says the slot is over there",
      shadow.slot_over({1}, set(), 1000.4, 1000) and shadow.refusal(400) and shadow.refusal(404))
check("  one that comes before it began does not, whatever it says", not shadow.slot_over({1}, set(), 999.9, 1000))
check("  nor one from a relay that refused on this head before the slot began, though another relay's still does",
      not shadow.slot_over({1}, {1}, 1000.4, 1000) and shadow.slot_over({1, 2}, {1}, 1000.4, 1000))
check("  nor do blocks taken after it began, nor a relay that says it is posted to too often, cannot serve, or nothing",
      not shadow.slot_over(set(), set(), 1000.4, 1000) and not any(shadow.refusal(s) for s in (200, 202, 429, 503, "no answer")))
check("with the block wanted 0.6 s after the slot begins, a round that fits is begun as late as it can be and none after",
      shadow.begin_at(999.9, 1000 + 0.6, 0.4) == 1000.2 and shadow.begin_at(1000.3, 1000 + 0.6, 0.4) is None)

if failed:
    sys.exit(f"round-check: {len(failed)} cases failed")
print("round-check: all as it should be")
