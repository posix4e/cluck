#!/usr/bin/env python3
"""Has the guest ask a relay something over TLS, itself, and looks at every frame that crossed its network.

    scripts/run-ask dev|tdx           the shadow image and a stand-in relay on this machine
    scripts/run-ask dev|tdx --live    the image that is meant and the four real relays' public lists
                                      (from evm/, after: scripts/build-efi dev|tdx evm-os-shadow, or evm-os)

Without --live nothing leaves this machine. The stand-in is `openssl s_server` with a certificate signed
by the stand-in's root (`scripts/standin.py`), serving a file with a word in it that is made up for the
run. The guest is asked for that file (`Evm/Ask.lean`) and must give it back; then it is asked things it
must refuse or fail at: a relay it does not have, a time before its roots were written, a path with a
space in it, a time at which the certificate has run out, a server whose certificate is for another name,
one whose certificate is under another root, and no server at all.

With --during=FILE, where FILE holds a request to build a block and bid for it, a question is put just
before the block is begun, and must be answered while the block is being built, not after. `tdx` needs SILO_TDVF naming the firmware, as the OS's TDX.md says. With --live the guest is asked for each relay's list of coming proposers, which is public and is what
`scripts/tls-get` fetched from the host. It sends the relay nothing but the request for that page.

Either way QEMU writes down every Ethernet frame the guest sent or was sent, and afterwards each one must
be something expected: the host's own conversation with the guest's service (port 5005), a question about
an Ethernet address, a name looked up, or a connection to a relay on which every byte is part of a TLS
record, and after the first messages every record a sealed one. The path asked for and the made-up word
must appear in no frame but the host's own conversation. That is the check that what the host carries
for the guest is TLS and nothing else. In `tdx` the first answer is also asked for with a report, and the
report's 64 bytes must be the hashes of that request and that answer."""
import hashlib, json, os, shutil, socket, struct, subprocess, sys, tempfile, time
here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
system = os.path.dirname(here)
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(here, "scripts"))
import standin

if len(sys.argv) < 2 or sys.argv[1] not in ("dev", "tdx"):
    sys.exit(__doc__)
mode, live = sys.argv[1], "--live" in sys.argv[2:]
name = "evm-os" if live else "evm-os-shadow"
image = os.path.join(here, ".lake/build/efi", mode, name, "BOOTX64.EFI")
if not os.path.exists(image):
    sys.exit(f"run-ask: no {image} (run: scripts/build-efi {mode} {name})")
slot = os.path.join(system, ".lake/build/efi", mode, name)
os.makedirs(slot, exist_ok=True)
shutil.copyfile(image, os.path.join(slot, "BOOTX64.EFI"))
port = int(os.environ.get("SILO_HOST_PORT", "5016"))
scratch = tempfile.mkdtemp(prefix="run-ask.")
log = os.path.join(here, ".lake/build/efi", mode, name, "serial.log")
capture = os.path.join(here, ".lake/build/efi", mode, name, "ask.pcap")
PATH = "/relay/v1/builder/validators"
word = "a word made up for this run: " + os.urandom(12).hex()
failed = 0
def check(what, good, more=""):
    global failed
    failed += not good
    print(f"{'as it should be' if good else 'WRONG':>15}  {what}{': ' + more if more else ''}")

def serial():
    with open(log, "rb") as f: return f.read().decode("utf-8", "replace")

def exchange(request, patience=120):
    with socket.create_connection(("127.0.0.1", port), timeout=10) as s:
        s.settimeout(patience)
        s.sendall(struct.pack(">I", len(request)) + request)
        got = b""
        while len(got) < 4 or len(got) < 4 + struct.unpack(">I", got[:4])[0]:
            piece = s.recv(65536)
            if not piece: break
            got += piece
        return got[4:]

def ask(relay, path, seconds=None):
    """The guest's answer: (0, the relay's status, the body), or (1 or 2, 0, the reason)."""
    got = exchange(b"JASK1" + bytes([relay]) + struct.pack(">Q", seconds or int(time.time())) + path.encode())
    return (got[0], got[1] * 256 + got[2], got[3:]) if len(got) >= 3 else (-1, 0, got)

servers = []
def stand_in(names=(standin.NAME,), signed_by_root=True):
    """`openssl s_server` on the stand-in's port, serving the made-up word at the path asked for."""
    for process in servers: process.kill(); process.wait()
    servers.clear()
    root = os.path.join(scratch, "www"); os.makedirs(os.path.join(root, os.path.dirname(PATH).lstrip("/")), exist_ok=True)
    with open(os.path.join(root, PATH.lstrip("/")), "w") as f: f.write(json.dumps([{"slot": "1", "note": word}]))
    key, certificate = standin.server(names)
    if not signed_by_root:
        # The same shape of certificate, signed by a key that is nobody's root.
        from cryptography.hazmat.primitives.asymmetric import ec
        true = standin.root_key
        standin.root_key = lambda: ec.generate_private_key(ec.SECP256R1())
        key, certificate = standin.server(names)
        standin.root_key = true
    open(os.path.join(scratch, "leaf.key"), "wb").write(key); open(os.path.join(scratch, "leaf.pem"), "wb").write(certificate)
    servers.append(subprocess.Popen(["openssl", "s_server", "-accept", f"127.0.0.1:{standin.PORT}", "-cert", os.path.join(scratch, "leaf.pem"),
                                     "-key", os.path.join(scratch, "leaf.key"), "-WWW", "-quiet"], cwd=root,
                                    stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
    for _ in range(100):
        try: socket.create_connection(("127.0.0.1", standin.PORT), timeout=0.2).close(); return
        except OSError: time.sleep(0.05)

if os.path.exists(capture): os.remove(capture)
guest = subprocess.Popen([os.path.join(system, "scripts/run-efi"), mode, name], cwd=system,
                         env=dict(os.environ, SILO_HOST_PORT=str(port), SILO_NET_DUMP=capture),
                         stdout=open(log, "wb"), stderr=subprocess.STDOUT, start_new_session=True)
relay_ports = {443} if live else {standin.PORT}
try:
    started = time.time()
    while "serving TCP 5005" not in serial():
        if guest.poll() is not None or time.time() - started > 300:
            sys.exit("the guest did not come up; its serial output:\n" + serial()[-2000:])
        time.sleep(0.25)
    print(f"guest up after {time.time() - started:.1f} s: {[l for l in serial().splitlines() if 'connects out' in l][-1]}")
    if live:
        names = ["boost-relay.flashbots.net", "relay-builders-us.ultrasound.money", "aestus.live", "us-global.titanrelay.xyz"]
        for i, relay in enumerate(names):
            began = time.time()
            status, http, body = ask(i, PATH)
            try: entries = json.loads(body); shape = isinstance(entries, list) and all("slot" in e for e in entries)
            except ValueError: entries, shape = [], False
            check(f"{relay}'s list of coming proposers", status == 0 and http == 200 and shape,
                  f"HTTP {http}, {len(body)} bytes, {len(entries)} entries, {time.time() - began:.2f} s" if status == 0 else body.decode(errors="replace"))
        status, http, body = ask(4, PATH)
        check("a fifth relay, which this image does not have", status == 2, body.decode(errors="replace"))
    else:
        stand_in()
        expected = open(os.path.join(scratch, "www", PATH.lstrip("/")), "rb").read()
        began = time.time()
        status, http, body = ask(0, PATH)
        check("the stand-in asked for its page", status == 0 and http == 200 and body == expected,
              f"HTTP {http}, {len(body)} bytes, {time.time() - began:.2f} s" if status == 0 else body.decode(errors="replace"))
        status, http, body = ask(0, PATH)
        check("and again, on a new connection", status == 0 and body == expected)
        for what, relay, path, seconds, wanted, reason in [
                ("a relay this image does not have", 1, PATH, None, 2, "no relay"),
                ("a time before the roots were written", 0, PATH, 1700000000, 2, "before"),
                ("a path with a space in it", 0, "/a b", None, 2, "cannot be read"),
                ("a path that does not begin with /", 0, "relay", None, 2, "cannot be read"),
                ("a time at which the certificate has run out", 0, PATH, int(time.time()) + 400 * 86400, 1, "out of date"),
                ("a page the stand-in does not have", 0, "/nothing/here", None, 0, "")]:
            status, http, body = ask(relay, path, seconds)
            check(what, status == wanted and reason.encode() in body, body[:80].decode(errors="replace") if status else f"HTTP {http}")
        stand_in(("other.test",))
        status, http, body = ask(0, PATH)
        check("a server whose certificate is for another name", status == 1 and b"another name" in body, body.decode(errors="replace"))
        stand_in(signed_by_root=False)
        status, http, body = ask(0, PATH)
        check("a server whose certificate is under another root", status == 1 and b"does not reach a root" in body, body.decode(errors="replace"))
        for process in servers: process.kill(); process.wait()
        servers.clear()
        status, http, body = ask(0, PATH)
        check("no server at all", status == 1, body.decode(errors="replace"))
        stand_in()
        status, http, body = ask(0, PATH)
        check("the stand-in again, after all that", status == 0 and body == expected)
    if mode == "tdx":
        challenge = os.urandom(32)
        request = b"JASK1" + bytes([0]) + struct.pack(">Q", int(time.time())) + PATH.encode()
        got = exchange(b"JATT1" + challenge + request)
        reply, report = got[:-1024], got[-1024:]
        bound = hashlib.sha256(challenge + request).digest() + hashlib.sha256(reply).digest()
        check("the same asked for with a report", len(got) > 1024 and reply[:1] == b"\0" and report[128:192] == bound,
              f"{len(reply)} bytes and a report whose 64 bytes are the hashes of the request and of the answer")
    key = exchange(b"JKEY1")
    check("the builder's key still answered", len(key) == 48)
    during = [a.split("=", 1)[1] for a in sys.argv[2:] if a.startswith("--during=")]
    if during:
        # One request runs at a time, so a question cannot begin while a block is being built; but one
        # that has begun must go on. The request to build is sent all but its last byte, then the
        # question, then the last byte: the block is begun with the question on its way to the relay.
        import threading
        build = open(during[0], "rb").read()
        began = time.time(); exchange(build, 600); alone = time.time() - began
        began = time.time(); ask(0, PATH); quiet = time.time() - began
        framed = struct.pack(">I", len(build)) + build
        with socket.create_connection(("127.0.0.1", port), timeout=10) as builder:
            builder.settimeout(600)
            builder.sendall(framed[:-1])
            time.sleep(1.0)
            times = {}
            def question():
                times["status"] = ask(0, PATH)[0]; times["answered"] = time.time() - began
            began = time.time()
            thread = threading.Thread(target=question); thread.start()
            time.sleep(0.004)
            builder.sendall(framed[-1:])
            got = b""
            while len(got) < 4 or len(got) < 4 + struct.unpack(">I", got[:4])[0]:
                piece = builder.recv(65536)
                if not piece: break
                got += piece
            times["built"] = time.time() - began
            thread.join()
        check("a question already on its way is answered while a block is being built",
              times["status"] == 0 and times["answered"] < times["built"] and times["answered"] < quiet + 0.5 * alone,
              f"the block took {alone:.2f} s alone and {times['built']:.2f} s with the question; the question was answered in "
              f"{times['answered']:.2f} s ({quiet:.2f} s when nothing else is going on)")
finally:
    try: os.killpg(guest.pid, 15)
    except ProcessLookupError: pass
    guest.wait()
    for process in servers: process.kill()

# ---- every frame the guest sent or was sent ---------------------------------------------------------
data = open(capture, "rb").read()
frames, at = [], 24
while at + 16 <= len(data):
    size = struct.unpack("<I", data[at + 8:at + 12])[0]
    frames.append(data[at + 16:at + 16 + size]); at += 16 + size
kinds, streams, strange, leaked = {}, {}, [], 0
secrets = [PATH.encode()] + ([] if live else [word.encode()])
def count(kind): kinds[kind] = kinds.get(kind, 0) + 1
for f in frames:
    kind = f[12:14]
    if kind == b"\x08\x06": count("questions about Ethernet addresses (ARP)"); continue
    if kind == b"\x86\xdd": count("IPv6 housekeeping from QEMU's network"); continue
    if kind != b"\x08\x00": strange.append(f); continue
    header = (f[14] & 15) * 4
    total = struct.unpack(">H", f[16:18])[0]
    protocol, body = f[23], f[14 + header:14 + total]
    sport, dport = struct.unpack(">HH", body[:4])
    if protocol == 17 and 53 in (sport, dport) and live: count("names looked up (DNS)")
    elif protocol == 6 and 5005 in (sport, dport): count("the host's own conversation with the service"); continue
    elif protocol == 6 and (sport in relay_ports or dport in relay_ports):
        count("TCP segments to and from a relay")
        offset = (body[12] >> 4) * 4
        if len(body) > offset:
            flow = (f[26:30], sport, f[30:34], dport)
            streams.setdefault(flow, {})[struct.unpack(">I", body[4:8])[0]] = body[offset:]
    else: strange.append(f); continue
    leaked += any(s in f for s in secrets)
records = {}
broken = 0
for flow, pieces in streams.items():
    # The pieces in order of their place in the stream; a piece sent twice is counted once.
    first = min(pieces)
    stream, expected = b"", first
    for seq in sorted(pieces, key=lambda s: (s - first) % 2**32):
        if seq == expected: stream += pieces[seq]; expected = (seq + len(pieces[seq])) % 2**32
    at, sealed_since = 0, False
    while at + 5 <= len(stream):
        kind, size = stream[at], struct.unpack(">H", stream[at + 3:at + 5])[0]
        # In the clear: only the first two messages (22) and the record that means nothing (20).
        good = stream[at + 1] == 3 and size <= 16640 and (kind == 23 or (kind in (20, 22) and not sealed_since))
        if kind == 22 and stream[at + 5] not in (1, 2): good = False
        sealed_since = sealed_since or kind == 23
        broken += not good
        if not good: break
        records[kind] = records.get(kind, 0) + 1; at += 5 + size
    broken += at != len(stream)
print(f"\n{len(frames)} frames crossed the guest's network: " + "; ".join(f"{n} {k}" for k, n in sorted(kinds.items())))
check("no frame of any other kind", not strange, f"{len(strange)} unexpected" if strange else "")
check("every byte on a connection to a relay is part of a TLS record", streams and not broken,
      f"{len(streams)} one-way streams; records: {records.get(22, 0)} first messages in the clear, {records.get(20, 0)} that mean nothing, {records.get(23, 0)} sealed")
check("the path asked for" + ("" if live else " and the made-up word") + " in no frame but the host's own conversation", leaked == 0)
shutil.rmtree(scratch, ignore_errors=True)
print("every check as it should be" if not failed else f"{failed} WRONG")
sys.exit(1 if failed else 0)
