#!/usr/bin/env python3
"""Boots the service as an EFI guest, puts fixture requests to it over TCP, and checks each answer.

    scripts/run-fixtures dev|tdx [--spec] [--limits] [--key] [--quotes N] [--from DIR] [name...]   (from evm/, after: scripts/build-efi dev|tdx)

`dev` is an emulated processor and OVMF, and runs anywhere QEMU does. `tdx` is an Intel TDX trust domain,
and needs what the OS's TDX.md says a host needs, with SILO_TDVF naming the firmware built there. The
guest is started by the OS's scripts/run-efi and is ended when this is done. Exit status 0 only if every
answer is byte for byte the one expected.

The guest is the image that builds for relays (`evm-os`), which has the fast engine alone. With no names
it is sent what that engine answers: the requests to build of fixtures/build/ and the blocks to judge of
fixtures/stateless/, each marked for the fast engine and not for Jaune, and each has to get the answer
kept there, which is the one Jaune gave. Then one request of each kind that needs Jaune, as kept, which
it has to refuse (one byte, 5, and 32 of zero).

With `--spec` the guest is the image with every engine (`evm-os-spec`, scripts/build-efi dev|tdx
evm-os-spec), and with no names every request in fixtures/ is sent as it is: chains imported whole by
Jaune. `--from DIR` takes the requests and the answers they must get from DIR instead (NAME.req,
NAME.expected), as they are, whichever image: blocks of mainnet with their witnesses are too large to keep
here (witness/fetch makes them).

`--limits` then tries what the guest must refuse: a frame longer than it accepts, and two clients that
between them hold more of unfinished requests than it keeps. Each must be closed, and a fixture must still
get its answer afterwards. It sends some 60 MB, which an emulated processor takes minutes over.

`--key` then asks the guest for its builder's key, twice, and for a bid on a block built from a fixture,
and has `bid-verify` check the bid's signature under that key from outside (lake build bid-verify). The
key is drawn when the guest starts, so no answer here can be a fixture.

`--quotes N` then asks the guest N times over for its key with a report and to have the report made a
quote by its host (`Evm/Attest.lean`, "JQUO1"). Each must come back a quote of that report, and the key
must be one key throughout: a guest that began again while asked has another. (On Google's machines one
such request in ten ended the guest, until the firmware's clock was stopped for the call: TODO.md.) A
guest started here has a host that makes quotes only when SILO_TDX_QGS names the quoting service's
socket (the OS's scripts/run-efi).

For each request it prints the time from the first byte sent to the answer, and how much of that the guest
says it spent on the request; the rest is the request on its way in.

SILO_HOST_PORT is the loopback port the guest's port 5005 is forwarded to (default 5015).

    scripts/run-fixtures dev|tdx --tap [--delay MS] [--limits] [--key] [--quotes N] [--from DIR] [name...]

With `--tap` the guest is not behind the emulator's own network, which ends every TCP connection beside
the guest and so hides what the guest's TCP does over a distance. It gets a tap device in a network of
this program's own making (a user and network namespace: no root), with the kernel's vhost-net behind
it, and the requests go from Linux's TCP straight to the guest's at 10.0.2.15. `--delay` holds every
frame from Linux back so many milliseconds, which is then the round trip.

    scripts/run-fixtures dev|tdx --at HOST [--limits] [--key] [--quotes N] [--from DIR] [name...]

With `--at` no guest is started: the requests go to one already running at HOST, port 5005 (on a
machine somewhere else, say), and its console is not read, so the guest's own share of each time is not
said. The first word still names where the bid's files are kept here.
"""
import glob, os, re, shutil, signal, socket, struct, subprocess, sys, time

if len(sys.argv) < 2 or sys.argv[1] not in ("dev", "tdx"):
    sys.exit(__doc__)
mode, names = sys.argv[1], sys.argv[2:]
spec = names[:1] == ["--spec"]
if spec:
    names = names[1:]
image_name = "evm-os-spec" if spec else "evm-os"
at = None
if names[:1] == ["--at"] and len(names) > 1:
    at, names = names[1], names[2:]
tap = names[:1] == ["--tap"]
delay = 0
if tap:
    names = names[1:]
    if names[:1] == ["--delay"] and len(names) > 1:
        delay, names = int(names[1]), names[2:]
    if os.environ.get("FIXTURES_INSIDE") != "1":
        os.execvpe("unshare", ["unshare", "-Urn", sys.executable, os.path.abspath(__file__)] + sys.argv[1:],
                   dict(os.environ, FIXTURES_INSIDE="1"))
here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
system = os.path.dirname(here)
fixtures = os.path.join(here, "fixtures")
limits = names[:1] == ["--limits"]
if limits:
    names = names[1:]
keyed = names[:1] == ["--key"]
if keyed:
    names = names[1:]
quotes = 0
if names[:1] == ["--quotes"] and len(names) > 1:
    quotes, names = int(names[1]), names[2:]
given = names[:1] == ["--from"] and len(names) > 1
if given:
    fixtures, names = os.path.abspath(names[1]), names[2:]

def kept(directory, name):
    with open(os.path.join(directory, name + ".req"), "rb") as f:
        request = f.read()
    with open(os.path.join(directory, name + ".expected"), "rb") as f:
        return request, f.read()

# What is sent: a name for the line printed, the request, and the answer it must get.
REFUSED = b"\x05" + bytes(32)
if names or given or spec:
    names = names or sorted(os.path.basename(p)[:-4] for p in glob.glob(os.path.join(fixtures, "*.req")))
    cases = [(name, *kept(fixtures, name)) for name in names]
else:
    cases = []
    for kind, mark in (("build", b"JBLF1"), ("stateless", b"JWIF1")):
        directory = os.path.join(fixtures, kind)
        for name in sorted(os.path.basename(p)[:-4] for p in glob.glob(os.path.join(directory, "*.req"))):
            request, expected = kept(directory, name)
            cases.append((f"{kind}/{name}, by the fast engine", mark + request[5:], expected))
    for directory, name in ((fixtures, "highGasUsage"), (os.path.join(fixtures, "stateless"), "highGasUsage-11"),
                            (os.path.join(fixtures, "build"), "highGasUsage-11")):
        cases.append((f"{os.path.relpath(os.path.join(directory, name), fixtures)} as kept, for Jaune: to be refused",
                      kept(directory, name)[0], REFUSED))
image = os.path.join(here, ".lake/build/efi", mode, image_name, "BOOTX64.EFI")
if not at and not os.path.exists(image):
    sys.exit(f"run-fixtures: no {image} (run: scripts/build-efi {mode}{' evm-os-spec' if spec else ''})")
port = int(os.environ.get("SILO_HOST_PORT", "5015"))
log = os.path.join(here, ".lake/build/efi", mode, image_name, "serial.log")
os.makedirs(os.path.dirname(log), exist_ok=True)
guest = None
if not at:
    # The OS's launcher looks for an image under its own build directory, by name.
    slot = os.path.join(system, ".lake/build/efi", mode, image_name)
    os.makedirs(slot, exist_ok=True)
    shutil.copyfile(image, os.path.join(slot, "BOOTX64.EFI"))
    guest = subprocess.Popen([os.path.join(system, "scripts/run-efi"), mode, image_name], cwd=system,
                             env=dict(os.environ, SILO_HOST_PORT=str(port), **({"SILO_NET_TAP": "tap0"} if tap else {})),
                             stdout=open(log, "wb"), stderr=subprocess.STDOUT, start_new_session=True)
where = (at, 5005) if at else ("10.0.2.15", 5005) if tap else ("127.0.0.1", port)
if tap:
    # QEMU makes the device; this end gives it the address the guest takes for its gateway.
    for _ in range(200):
        if subprocess.run(["ip", "link", "show", "tap0"], capture_output=True).returncode == 0:
            break
        time.sleep(0.1)
    for command in ("ip addr add 10.0.2.2/24 dev tap0", "ip link set tap0 up", "ip link set lo up"):
        subprocess.run(command.split(), check=True)
    if delay:
        subprocess.run(f"tc qdisc add dev tap0 root netem delay {delay}ms limit 100000".split(), check=True)

def serial():
    if at:
        return ""
    with open(log, "rb") as f:
        return f.read().decode("utf-8", "replace")

def exchange(request, patience):
    with socket.create_connection(where, timeout=10) as s:
        s.settimeout(patience)
        s.sendall(struct.pack(">I", len(request)) + request)
        # One frame back: four bytes of length, then that many. A verdict is 69 bytes; a block that was
        # built is as long as its header and the list of what went into it.
        got = b""
        while len(got) < 4 or len(got) < 4 + struct.unpack(">I", got[:4])[0]:
            piece = s.recv(65536)
            if not piece:
                break
            got += piece
        return got

failed = 0
try:
    started = time.time()
    while not at and "serving TCP 5005" not in serial():
        if guest.poll() is not None or time.time() - started > 300:
            print("the guest did not come up; its serial output:\n" + serial()[-2000:])
            sys.exit(2)
        time.sleep(0.25)
    print(f"the guest at {at}" if at else f"guest up after {time.time() - started:.1f} s")
    for name, request, expected in cases:
        sent = time.time()
        try:
            got = exchange(request, 3600)
        except OSError as error:
            got = b""
            print(f"{name}: {error}")
        took = time.time() - sent
        ok = got == struct.pack(">I", len(expected)) + expected
        failed += not ok
        inside = re.findall(r"evm: status \d+, (\d+) ms", serial())
        inside = f", {int(inside[-1]) / 1000:.2f} s of it in the guest" if inside else ""
        print(f"{name}: {len(request)} bytes, {'the expected answer' if ok else 'WRONG ' + got.hex()}, "
              f"{took:.2f} s{inside}")
    if limits:
        def closed(s, patience=30):
            """Whether the guest ends the connection without sending a byte."""
            s.settimeout(patience)
            try:
                return s.recv(1) == b""
            except (ConnectionError, socket.timeout) as error:
                return isinstance(error, ConnectionError)

        def partial(megabytes):
            """A client part way through a request of 32 MiB less one byte."""
            s = socket.create_connection(where, timeout=10)
            s.settimeout(600)
            s.sendall(struct.pack(">I", 32 * 1024 * 1024 - 1) + bytes(megabytes * 1024 * 1024))
            return s

        with socket.create_connection(where, timeout=10) as s:
            s.sendall(struct.pack(">I", 32 * 1024 * 1024 + 1) + bytes(64))
            ok = closed(s)
        failed += not ok
        print(f"a frame one byte over the longest accepted: {'closed' if ok else 'NOT CLOSED'}")
        first = partial(30)
        try:
            second = partial(9)
            try:
                second.sendall(bytes(2 * 1024 * 1024))
            except ConnectionError:
                pass
            ok = closed(second)
            second.close()
        except ConnectionError:
            ok = True
        failed += not ok
        print(f"a second client taking what is held past the limit: {'closed' if ok else 'NOT CLOSED'}")
        first.close()
        _, request, expected = cases[0]
        ok = exchange(request, 600) == struct.pack(">I", len(expected)) + expected
        failed += not ok
        print(f"a fixture after that: {'the expected answer' if ok else 'WRONG'}")
    if keyed:
        key = exchange(b"JKEY1", 60)[4:]
        again = exchange(b"JKEY1", 60)[4:]
        ok = len(key) == 48 and key == again
        failed += not ok
        print(f"the builder's key, asked for twice: {key.hex() if ok else 'NOT ONE KEY'}")
        with open(os.path.join(here, "fixtures/build/DelegateCallSpam-1.req"), "rb") as f:
            build = f.read()
        if not spec:
            build = b"JBLF1" + build[5:]      # this image builds with the fast engine alone
        asked = b"JBID2" + struct.pack(">Q", 15700576) + bytes(range(48)) + bytes(4) + bytes(4) + build
        sent = time.time()
        reply = exchange(asked, 600)[4:]
        took = time.time() - sent
        work = os.path.join(here, ".lake/build/efi", mode, image_name)
        with open(os.path.join(work, "bid.req"), "wb") as f:
            f.write(asked)
        with open(os.path.join(work, "bid.reply"), "wb") as f:
            f.write(reply)
        checked = subprocess.run([os.path.join(here, ".lake/build/bin/bid-verify"), os.path.join(work, "bid.req"),
                                  os.path.join(work, "bid.reply")], capture_output=True, text=True)
        ok = checked.returncode == 0 and reply[-144:-96] == key
        failed += not ok
        print(f"a bid for a block built from a fixture, {took:.2f} s: "
              f"{'signed by that key, and the signature verifies' if ok else 'NOT VERIFIED: ' + checked.stdout.strip()}")
    if quotes:
        # A quote is 48 bytes of heading and then the trust domain's report as the quote has it, whose
        # last 64 bytes are the report data; in the report the guest made they are 128 bytes in.
        first, made, why = None, 0, ""
        for n in range(quotes):
            try:
                answer = exchange(b"JATT1" + os.urandom(32) + b"JKEY1", 60)[4:]
                if len(answer) != 48 + 1024:
                    why = f"at the {n + 1}th, no report came with the key ({len(answer)} bytes)"
                    break
                first = first or answer[:48]
                if answer[:48] != first:
                    why = f"at the {n + 1}th the key was another: THE GUEST BEGAN AGAIN"
                    break
                report = answer[48:]
                quote = exchange(b"JQUO1" + report, 60)[4:]
            except OSError as error:
                why = f"at the {n + 1}th: {error}"
                break
            if quote[:1] != b"\0" or len(quote) < 1 + 48 + 584 or quote[1 + 48 + 520:1 + 48 + 584] != report[128:192]:
                why = f"the {n + 1}th was no quote of the report: {quote[:1].hex()} {quote[1:120].decode(errors='replace')!r}"
                break
            made += 1
        ok = made == quotes
        failed += not ok
        print(f"{quotes} quotes asked for, one after another: {'each a quote of its report, under one key' if ok else 'FAILED, ' + why}")
finally:
    if guest is not None:
        try:
            os.killpg(guest.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        guest.wait(timeout=20)
        print("serial:")
    for line in serial().splitlines():
        if line.startswith(("silo:", "evm:")):
            print("  " + line)
sys.exit(1 if failed else 0)
