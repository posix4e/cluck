#!/usr/bin/env bash
# A quote from the builder's guest on Compute Engine, checked against an image's file:
#
#   scripts/gce-check BOOTX64.EFI QUOTE
#
# Three questions, each answered by the tool that answers it, and all must come out right:
#   is the quote a real one (evm/demo/check-quote.mjs: its signatures up to Intel's root, by the same
#     code the page uses; needs node),
#   is it a quote of this program (scripts/gce-measure: RTMR1 worked out from the file), and
#   is the firmware it was started by one Google signed for (scripts/gce-firmware: Google's statement
#     for the quote's MRTD, fetched from Google and its signatures checked; needs openssl and the network).
# What none of them answers is said by each, and comes to: what Google's firmware does, which is Google's
# to vouch for; RTMR0, the machine's configuration as that firmware measured it; whether Intel or Google
# has since withdrawn anything.
set -euo pipefail
[[ $# -eq 2 && -r "$1" && -r "$2" ]] || { echo "usage: scripts/gce-check BOOTX64.EFI QUOTE" >&2; exit 2; }
here="$(cd "$(dirname "$0")" && pwd)"
echo "Is it a real quote?"
node "$here/../evm/demo/check-quote.mjs" "$2"
echo "Is it a quote of this program?"
"$here/gce-measure" "$1" "$2" | tail -n 1
echo "Is the firmware one Google signed for?"
python3 -I "$here/gce-firmware" "$2"
echo "All three hold: a trust domain started by Google's firmware and running this file made the quote."
