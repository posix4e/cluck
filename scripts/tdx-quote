#!/usr/bin/env python3
"""Fetch a nonce-bound TDREPORT from silo-os and submit it to this host's QGS."""
import argparse
import socket
import struct
import sys
from pathlib import Path


def read_exact(sock, length):
    data = bytearray()
    while len(data) < length:
        chunk = sock.recv(length - len(data))
        if not chunk:
            raise ValueError("connection closed before a complete reply")
        data.extend(chunk)
    return bytes(data)


def read_frame(sock, maximum):
    n, = struct.unpack(">I", read_exact(sock, 4))
    if not 0 < n <= maximum:
        raise ValueError(f"invalid reply size {n}")
    return read_exact(sock, n)


def get_report(host, port, data):
    with socket.create_connection((host, port), timeout=15) as sock:
        sock.sendall(struct.pack(">IB", 65, 5) + data)
        response = read_frame(sock, 1025)
    if response == b"\xff\x03":
        raise ValueError("guest cannot produce a TDREPORT on this platform")
    if len(response) != 1025 or response[0] != 0x85:
        raise ValueError("guest refused the request or returned an invalid TDREPORT size")
    return response[1:]


def get_quote(path, report):
    # Intel's QGS v1 message is little endian, inside a big-endian length frame.
    header = struct.Struct("<HHIIIII")
    request = header.pack(1, 1, 0, header.size + len(report), 0, len(report), 0) + report
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(30)
        sock.connect(path)
        sock.sendall(struct.pack(">I", len(request)) + request)
        response = read_frame(sock, 1024 * 1024)
    if len(response) < 16:
        raise ValueError("short QGS message")
    major, _, kind, size, error = struct.unpack_from("<HHIII", response)
    if major != 1 or kind != 1 or size != len(response):
        raise ValueError("invalid QGS response header")
    if error:
        raise ValueError(f"QGS returned error 0x{error:x}")
    if len(response) < header.size:
        raise ValueError("short QGS quote response")
    selected, length = struct.unpack_from("<II", response, 16)
    if length == 0 or header.size + selected + length != len(response):
        raise ValueError("invalid QGS quote lengths")
    return response[header.size + selected:]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("reportdata", help="64 bytes of verifier-supplied REPORTDATA in hex")
    parser.add_argument("file", type=Path, help="new output file for the signed quote")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=5005)
    parser.add_argument("--qgs", default="/var/run/tdx-qgs/qgs.socket")
    args = parser.parse_args()
    try:
        data = bytes.fromhex(args.reportdata)
        if len(data) != 64:
            parser.error("reportdata must encode exactly 64 bytes")
        quote = get_quote(args.qgs, get_report(args.host, args.port, data))
        with args.file.open("xb") as out:
            out.write(quote)
        print(f"wrote {len(quote)} bytes of unverified quote to {args.file}")
    except (ValueError, OSError) as err:
        sys.exit(f"tdx-quote: {err}")


if __name__ == "__main__":
    main()
