#!/usr/bin/env python3
"""Verify a silo-os TDX quote against Intel DCAP and independently trusted measurements."""
import argparse
import ctypes
import hmac
import json
import struct
import sys
import time
from pathlib import Path


def decode_hex(text, length, field):
    data = bytes.fromhex(text)
    if len(data) != length:
        raise ValueError(f"{field} must encode exactly {length} bytes")
    return data


def verify_dcap(quote):
    # Intel DCAP software QVL on x86-64 Linux. With collateral=NULL, QPL
    # obtains collateral using the verifier machine's own configuration.
    api = ctypes.CDLL("libsgx_dcap_quoteverify.so.1").tdx_qv_verify_quote
    u32 = ctypes.c_uint32
    pointer = ctypes.c_void_p
    api.argtypes = [pointer, u32, pointer, ctypes.c_long, ctypes.POINTER(u32),
                    ctypes.POINTER(u32), pointer, u32, pointer]
    api.restype = u32
    expired, verdict = u32(0xffffffff), u32(0xffffffff)
    status = api(quote, len(quote), None, int(time.time()), ctypes.byref(expired),
                 ctypes.byref(verdict), None, 0, None)
    if status or expired.value or verdict.value:
        raise ValueError(f"DCAP status 0x{status:x}, expired collateral {expired.value}, "
                         f"verification result 0x{verdict.value:x}")


def td_body(quote):
    if len(quote) < 54:
        raise ValueError("truncated quote header")
    version, _, tee = struct.unpack_from("<HHI", quote)
    if tee != 0x81:
        raise ValueError("expected Intel TDX evidence")
    if version == 4:
        at, size = 48, 584
    elif version == 5:
        kind, size = struct.unpack_from("<HI", quote, 48)
        if kind not in (2, 3):
            raise ValueError(f"unsupported TDX quote body type {kind}")
        at = 54
    else:
        raise ValueError(f"unsupported quote version {version}")
    if size < 584 or at + size > len(quote):
        raise ValueError("invalid TD quote body size")
    return quote[at:at+size]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("quote", type=Path)
    parser.add_argument("--reportdata", required=True, help="fresh challenge, exactly 64 bytes in hex")
    parser.add_argument("--measurements", type=Path, required=True,
                        help="trusted JSON object with MRTD and RTMR0..RTMR3 in hex")
    args = parser.parse_args()
    try:
        with args.quote.open("rb") as source:
            quote = source.read(1024 * 1024 + 1)
        if len(quote) > 1024 * 1024:
            raise ValueError("oversized quote")
        expected_data = decode_hex(args.reportdata, 64, "REPORTDATA")
        policy = json.loads(args.measurements.read_text())
        fields = {"MRTD": 136, "RTMR0": 328, "RTMR1": 376, "RTMR2": 424, "RTMR3": 472}
        if not isinstance(policy, dict) or set(policy) != set(fields):
            raise ValueError("policy must contain MRTD and all four RTMRs")
        expected = {name: decode_hex(policy[name], 48, name) for name in fields}
        body = td_body(quote)
        verify_dcap(quote)
        if struct.unpack_from("<Q", body, 120)[0] & 1:
            raise ValueError("TD debug attribute set")
        if not hmac.compare_digest(body[520:584], expected_data):
            raise ValueError("REPORTDATA differs from the verifier challenge")
        for name, at in fields.items():
            if not hmac.compare_digest(body[at:at+48], expected[name]):
                raise ValueError(f"{name} differs from policy")
    except (ValueError, TypeError, OSError, AttributeError) as err:
        sys.exit(f"verify-tdx-quote: {err}")
    print("verified Intel TDX quote, current collateral, DEBUG clear, REPORTDATA, MRTD and four RTMRs")


if __name__ == "__main__":
    main()
